</style>

{%- if section.settings.sticky_header_type != 'none' -%}
  <sticky-header
    data-sticky-type="{{ section.settings.sticky_header_type }}"
    class="header-navigation-wrapper desktop-only"
    {% if settings.enable_following_cursor and settings.following_cursor_style == 'default' %}
      no-effect-cursor
    {% endif %}
  >
{%- else -%}
  <div
    class="header-navigation-wrapper"
    {% if settings.enable_following_cursor and settings.following_cursor_style == 'default' %}
      no-effect-cursor
    {% endif %}
  >
{%- endif -%}
<div class="header-navigation header-nav-utility container container-{{ section.settings.container }}">
  <div class="container container-{{ section.settings.container }} d-flex flex-jc-between flex-align-center p-static o-unset{% if section.settings.sticky_header_width == 'full' %} sticky-container-full{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'logo' -%}
          <div
            class="header-logo header-item header-item--side d-flex flex-align-center fs-0 fg-0{% if block.settings.logo_position == 'main_menu'%} show-main-menu{% elsif block.settings.logo_position == 'sticky_menu'%} hide-main-menu{% else %}{% endif %}"
            style="--logo_font_size: {{block.settings.logo_font_size | append: 'px'}};--logo_font_weight: {{block.settings.logo_font_weight}};--logo_text_transform: {{block.settings.logo_text_transform}};--logo_text_color: {{block.settings.logo_color}};--logo_width: {{block.settings.logo_width | append: 'px'}};--logo_width_sticky: {{block.settings.logo_width_fixed | append: '%'}}"
          >
            {%- if request.page_type == 'index' -%}
              <h1 class="header__heading">
            {%- else -%}
              <div class="header__heading">
            {%- endif -%}
            <a href="{{ routes.root_url }}" class="header__heading-link focus-inset">
              {%- if block.settings.logo != blank -%}
                {%- assign logo = block.settings.logo -%}
                {%- assign logo_width = block.settings.logo_width -%}
                {%- assign logo_width_img = logo_width | append: 'x' -%}
                {%- assign logo_width_retina = logo_width | times: 2 | append: 'x' -%}
                {%- assign logo_height = logo_width | divided_by: logo.aspect_ratio | round -%}
                <img
                  srcset="{{ logo | img_url: logo_width_img }}, {{ logo | img_url: logo_width_retina }} 2x"
                  src="{{ logo | img_url: logo_width_img }}"
                  loading="lazy"
                  class="header__heading-logo w-100 h-auto ver-alg-mid d-inline-block"
                  alt="{{ logo.alt | default: shop.name | escape }}"
                  width="{{ logo_width }}"
                  height="{{ logo_height }}"
                >
              {%- elsif block.settings.logo_text != blank -%}
                <span class="header__heading-text {{ block.settings.logo_text_transform }} d-block">
                  {{- block.settings.logo_text -}}
                </span>
              {%- else -%}
                <span class="header__heading-text {{ block.settings.logo_text_transform }} d-block">
                  {{- shop.name -}}
                </span>
              {%- endif -%}
            </a>
            {%- if request.page_type == 'index' -%}
              </h1>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>

        {%- when 'mega_menu_products' -%}
          {%- comment -%} This block is handled within the main_menu rendering {%- endcomment -%}

        {%- when 'main_menu' -%}
          <div class="main-menu header-item p-static w-100{% if block.settings.label_position == 'none' %} label-none{% elsif block.settings.label_position == 'main_menu' %} label-main-menu{% if block.settings.new_label_1 != blank or block.settings.sale_label_1 != blank or block.settings.hot_label_1 != blank%} main-menu-hasLabel{% endif %}{% else %}{% endif %}{% if block.settings.menu_top_spacing <= 16 %} label-small{% endif %}">
            <div class="p-static container container-{{ section.settings.container }} o-unset">
              <div class="main-menu--wrapper" id="HeaderNavigation">
                {%- if block.settings.menu != blank -%}
                  <nav
                    class="header__inline-menu"
                    data-navigation
                    role="navigation"
                    style="--lv_1_color: {{ block.settings.lv_1_color }}; --lv_1_color_hover: {{ block.settings.lv_1_color_hover }};--lv_2_color: {{ block.settings.lv_2_color }};--lv_2_color_hover: {{ block.settings.lv_2_color_hover }};--lv_3_color: {{ block.settings.lv_3_color }};--lv_3_color_hover: {{ block.settings.lv_3_color_hover }};--menu_margin_left: -{{block.settings.grid_gap_menu_item | append: 'px'}};--menu_top_spacing: {{block.settings.menu_top_spacing | append: 'px'}};--menu_top_spacing_sticky: {% if block.settings.menu_top_spacing >= 19 %} -19px{% else %}-{{block.settings.menu_top_spacing | plus: 1 | append: 'px'}}{% endif %};--menu_bottom_spacing: {{block.settings.menu_bottom_spacing | append: 'px'}};--grid_gap_menu_item: {{block.settings.grid_gap_menu_item | append: 'px'}};--bg_mega_menu: {% if block.settings.bg_mega_menu_gradient != blank %}{{ block.settings.bg_mega_menu_gradient }}{% else %}{{ block.settings.bg_mega_menu }}{% endif %};--sale_item_color: {{block.settings.sale_item_color}};--new_label_color: {{ block.settings.new_label_color }};--new_label_border: {{ block.settings.new_label_bg }};--new_label_bg: {% if block.settings.new_label_bg_gradient != blank %}{{ block.settings.new_label_bg_gradient }}{% else %}{{ block.settings.new_label_bg }}{% endif %};--sale_label_color: {{ block.settings.sale_label_color }};--sale_label_border: {{ block.settings.sale_label_bg }};--sale_label_bg: {% if block.settings.sale_label_bg_gradient != blank %}{{ block.settings.sale_label_bg_gradient }}{% else %}{{ block.settings.sale_label_bg }}{% endif %};--hot_label_color: {{ block.settings.hot_label_color }};--hot_label_border: {{ block.settings.hot_label_bg }};--hot_label_bg: {% if block.settings.hot_label_bg_gradient != blank %}{{ block.settings.hot_label_bg_gradient }}{% else %}{{ block.settings.hot_label_bg }}{% endif %};--menu_lv1_font_size: {{ block.settings.menu_lv1_font_size | default: 16 | append: 'px' }};--menu_lv1_font_weight: {{ block.settings.menu_lv1_font_weight | default: 600 }};--menu_lv1_text_transform: {{ block.settings.menu_lv1_text_transform | default: 'uppercase' }};--menu_lv1_letter_spacing: {{ block.settings.menu_lv1_letter_spacing | default: 0 | append: 'px' }};--menu_lv1_line_height: {{ block.settings.menu_lv1_line_height | default: 1.4 }};--dropdown_lv2_font_size: {{ block.settings.dropdown_lv2_font_size | default: 15 | append: 'px' }};--dropdown_lv2_font_weight: {{ block.settings.dropdown_lv2_font_weight | default: 600 }};--dropdown_lv2_text_transform: {{ block.settings.dropdown_lv2_text_transform | default: 'uppercase' }};--dropdown_lv2_letter_spacing: {{ block.settings.dropdown_lv2_letter_spacing | default: 0 | append: 'px' }};--dropdown_lv2_line_height: {{ block.settings.dropdown_lv2_line_height | default: 1.4 }};--dropdown_lv3_font_size: {{ block.settings.dropdown_lv3_font_size | default: 14 | append: 'px' }};--dropdown_lv3_font_weight: {{ block.settings.dropdown_lv3_font_weight | default: 600 }};--dropdown_lv3_text_transform: {{ block.settings.dropdown_lv3_text_transform | default: 'uppercase' }};--dropdown_lv3_letter_spacing: {{ block.settings.dropdown_lv3_letter_spacing | default: 0 | append: 'px' }};--dropdown_lv3_line_height: {{ block.settings.dropdown_lv3_line_height | default: 1.4 }};"
                  >
                    {%- assign mega_menu_block = blank -%}
                    {%- for section_block in section.blocks -%}
                      {%- if section_block.type == 'mega_menu_products' -%}
                        {%- assign mega_menu_block = section_block -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}

                    <ul
                      class="list-menu list-menu--inline"
                      role="list"
                      style="justify-content: {{ block.settings.alignment }};"
                    >
                      {%- for link in block.settings.menu.links -%}
                        <li class="menu-lv-item menu-lv-1{% if link.links != blank %} has-submenu{% endif %}">
                          <a href="{{ link.url }}" class="header__menu-item">
                            {{ link.title | escape }}
                          </a>

                          {%- if mega_menu_block
                            and mega_menu_block.settings.show_product
                            and link.title == mega_menu_block.settings.item
                          -%}
                            <!-- Products Mega Menu -->
                            <div class="products-mega-menu">
                              <div class="mega-menu-content">
                                <div class="mega-menu-left-content">
                                  <h2 class="mega-menu-heading">
                                    {{ mega_menu_block.settings.product_title | default: 'See All Products' }}
                                  </h2>
                                  <div class="mega-menu-categories">
                                    {%- if link.links != blank -%}
                                      {%- for child_link in link.links -%}
                                        <a href="{{ child_link.url }}" class="mega-menu-category">
                                          <div class="mega-menu-image">
                                            {%- if child_link.url contains '/collections/' -%}
                                              {%- assign collection_handle = child_link.url
                                                | remove: '/collections/'
                                                | split: '/'
                                                | first
                                              -%}
                                              {%- assign collection = collections[collection_handle] -%}
                                              {%- if collection.featured_image -%}
                                                <img
                                                  src="{{ collection.featured_image | image_url: width: 90 }}"
                                                  alt="{{ collection.title }}"
                                                  loading="lazy"
                                                >
                                              {%- elsif collection.products.first.featured_image -%}
                                                <img
                                                  src="{{ collection.products.first.featured_image | image_url: width: 90 }}"
                                                  alt="{{ collection.products.first.title }}"
                                                  loading="lazy"
                                                >
                                              {%- else -%}
                                                <img
                                                  src="{{ 'product-placeholder.svg' | asset_url }}"
                                                  alt="{{ child_link.title }}"
                                                  loading="lazy"
                                                >
                                              {%- endif -%}
                                            {%- elsif child_link.url contains '/products/' -%}
                                              {%- assign product_handle = child_link.url
                                                | remove: '/products/'
                                                | split: '/'
                                                | first
                                              -%}
                                              {%- assign product = all_products[product_handle] -%}
                                              {%- if product.featured_image -%}
                                                <img
                                                  src="{{ product.featured_image | image_url: width: 90 }}"
                                                  alt="{{ product.title }}"
                                                  loading="lazy"
                                                >
                                              {%- else -%}
                                                <img
                                                  src="{{ 'product-placeholder.svg' | asset_url }}"
                                                  alt="{{ child_link.title }}"
                                                  loading="lazy"
                                                >
                                              {%- endif -%}
                                            {%- else -%}
                                              <img
                                                src="{{ 'product-placeholder.svg' | asset_url }}"
                                                alt="{{ child_link.title }}"
                                                loading="lazy"
                                              >
                                            {%- endif -%}
                                          </div>
                                          <div class="mega-menu-category-info">
                                            <h3 class="mega-menu-category-title">{{ child_link.title }}</h3>
                                            {%- if child_link.links != blank -%}
                                              <p class="mega-menu-category-desc">
                                                {{ child_link.links.size }} subcategories
                                              </p>
                                            {%- endif -%}
                                          </div>
                                        </a>
                                      {%- endfor -%}
                                    {%- else -%}
                                      <div class="mega-menu-no-items">
                                        <p>
                                          No submenu items found. Please add submenu items to your "{{ link.title }}"
                                          menu item in your Shopify admin.
                                        </p>
                                      </div>
                                    {%- endif -%}
                                  </div>
                                </div>

                                {%- if mega_menu_block.settings.show_az_brand -%}
                                  <div class="mega-menu-sidebar">
                                    {%- if mega_menu_block.settings.banner_1 -%}
                                      <img
                                        src="{{ mega_menu_block.settings.banner_1 | image_url: width: 280 }}"
                                        alt="{{ mega_menu_block.settings.az_brand_title }}"
                                        class="mega-menu-brand-image"
                                      >
                                    {%- else -%}
                                      <img
                                        src="https://via.placeholder.com/280x200/6B8E23/ffffff?text=Your+Brand"
                                        alt="Brand Image"
                                        class="mega-menu-brand-image"
                                      >
                                    {%- endif -%}
                                    <h3 class="mega-menu-brand-title">
                                      {{ mega_menu_block.settings.az_brand_title | default: 'Industrial Chocolate' }}
                                    </h3>
                                    <p class="mega-menu-brand-subtitle">
                                      {{ mega_menu_block.settings.az_brand_subtitle | default: 'Altinmarka Brand' }}
                                    </p>
                                    <p class="mega-menu-brand-subtitle">
                                      {{
                                        mega_menu_block.settings.az_brand_desc
                                        | default: 'Distributed by Bata Food USA UM'
                                      }}
                                    </p>
                                    <a
                                      href="{{ mega_menu_block.settings.az_brand_url | default: '/collections/all' }}"
                                      class="mega-menu-brand-btn"
                                    >
                                      {{ mega_menu_block.settings.az_brand_link_text | default: 'View Products' }}
                                      <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"/>
                                      </svg>
                                    </a>
                                  </div>
                                {%- endif -%}
                              </div>
                            </div>

                          {%- elsif link.links != blank -%}
                            <!-- Regular Dropdown Menu -->
                            <ul class="sub-menu list-menu--disclosure" role="list">
                              {%- for child_link in link.links -%}
                                <li class="menu-lv-item menu-lv-2{% if child_link.links != blank %} has-sub-submenu{% endif %}">
                                  <a href="{{ child_link.url }}" class="header__submenu-item">
                                    {{ child_link.title }}
                                  </a>

                                  {%- if child_link.links != blank -%}
                                    <ul class="sub-sub-menu list-menu--disclosure" role="list">
                                      {%- for grandchild_link in child_link.links -%}
                                        <li class="menu-lv-item menu-lv-3">
                                          <a href="{{ grandchild_link.url }}" class="header__submenu-item">
                                            {{ grandchild_link.title }}
                                          </a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  {%- endif -%}
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'header_icons' -%}
          <div
            class="header-icons header-item header-item--side d-flex flex-align-center flex-wrap fs-0 pt-2 pb-5{% if block.settings.show_search_sticky == false and block.settings.show_customer_sticky == false and block.settings.show_wishlist_sticky == false and block.settings.show_cart_sticky == false and block.settings.show_language_currency_sticky == false and block.settings.show_whatsapp_sticky == false %} show-main-menu{% endif %}{% if block.settings.show_language_currency == false and block.settings.show_search == false and block.settings.show_customer == false and block.settings.show_wishlist == false and block.settings.show_cart == false and block.settings.show_whatsapp == false %} hide-main-menu{% endif %}"
            style="--header_icons_color: {{block.settings.header_icons_color}};--header_icons_color_hover: {{block.settings.header_icons_color_hover}};--cart_count_bubble_bg: {% if block.settings.cart_count_bubble_bg_gradient != blank %}{{ block.settings.cart_count_bubble_bg_gradient }}{% else %}{{ block.settings.cart_count_bubble_bg }}{% endif %};--cart_count_bubble_color: {{block.settings.cart_count_bubble_color}};--cart_count_bubble_font_size: {% if block.settings.text_font_size <= 12 %}{{block.settings.text_font_size | append: 'px'}}{% else %} {{block.settings.text_font_size | minus: 2 | append: 'px'}}{% endif %};--text_font_size: {{block.settings.text_font_size | append: 'px' }}"
          >
            {%- if block.settings.show_language_currency or block.settings.show_language_currency_sticky -%}
              <div class="header-language_currency language_currency_style_1 d-inline-block{% if block.settings.show_language_currency_sticky %}{% if block.settings.show_language_currency %}{% else %} hide-main-menu{% endif %}{% else %}{% if block.settings.show_language_currency %} show-main-menu{% endif %}{% endif %}">
                <div class="top-language-currency ft-0 d-flex sticky_effect{% if settings.enable_currencies %} enable-currency{% endif %}">
                  {%- if settings.enable_multilang_shopify -%}
                    {% render 'halo-top-language' %}
