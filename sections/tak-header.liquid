            /* Hover effects for language text */
            .header-nav-utility .translation-widget:hover span,
            .header-nav-utility .language-switcher:hover span,
            .header-nav-utility .locale-selector:hover span,
            .header-nav-utility .weglot-flags:hover span,
            .header-nav-utility .langify-language-picker:hover span {
