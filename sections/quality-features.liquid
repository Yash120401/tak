{%- liquid
  assign container = section.settings.container
  assign section_bg_color = section.settings.background_color

  # Padding settings
  assign padding_top_desktop = section.settings.padding_top
  assign padding_top_tablet = section.settings.padding_top_tablet
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_desktop = section.settings.padding_bottom
  assign padding_bottom_tablet = section.settings.padding_bottom_tablet
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  # Margin settings
  assign margin_top_desktop = section.settings.margin_top
  assign margin_top_tablet = section.settings.margin_top_tablet
  assign margin_top_mobile = section.settings.margin_top_mobile
  assign margin_bottom_desktop = section.settings.margin_bottom
  assign margin_bottom_tablet = section.settings.margin_bottom_tablet
  assign margin_bottom_mobile = section.settings.margin_bottom_mobile
-%}

<!-- Quality Features Banner Section -->
<section class="quality-features-banner section-{{ section.id }}" id="section-{{ section.id }}">
  <div class="quality-banner-container">
    <div
      class="quality-features-overlay"
      style="
        --banner-bg-color: {{ section.settings.banner_bg_color | default: '#2E5903' }};
        --banner-bg-gradient: {% if section.settings.banner_bg_gradient != blank %}{{ section.settings.banner_bg_gradient }}{% else %}{{ section.settings.banner_bg_color | default: '#2E5903' }}{% endif %};
        --banner-border-radius: {{ section.settings.banner_border_radius | default: 15 }}px;
        --banner-padding: {{ section.settings.banner_padding | default: 40 }}px;
        --banner-offset-top: {{ section.settings.banner_offset_top | default: -60 }}px;
        --banner-max-width: {{ section.settings.banner_max_width | default: 90 }}%;
        --pattern-opacity: {{ section.settings.pattern_opacity | default: 15 | divided_by: 100.0 }};
      "
    >
      <div class="quality-banner-content">
        {%- if section.settings.main_title != blank -%}
          <h2 class="quality-main-title">{{ section.settings.main_title }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="quality-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="quality-features-grid">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'feature_item' -%}
                  <div class="quality-feature-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.feature_title != blank -%}
                      <h3 class="feature-title">{{ block.settings.feature_title }}</h3>
                    {%- endif -%}

                    {%- if block.settings.feature_description != blank -%}
                      <p class="feature-description">{{ block.settings.feature_description }}</p>
                    {%- endif -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .section-{{ section.id }} {
    margin-top: {{ margin_top_desktop }}px;
    margin-bottom: {{ margin_bottom_desktop }}px;
    padding-top: {{ padding_top_desktop }}px;
    padding-bottom: {{ padding_bottom_desktop }}px;
    {% if section_bg_color != blank %}
      background-color: {{ section_bg_color }};
    {% endif %}
    font-family: 'Kumbh Sans', sans-serif;
    position: relative;
  }

  .section-{{ section.id }} .quality-banner-container {
    {% if container == 'container' %}
      max-width: 1200px;
    {% elsif container == '1170' %}
      max-width: 1170px;
    {% elsif container == '1470' %}
      max-width: 1470px;
    {% elsif container == '1570' %}
      max-width: 1570px;
    {% elsif container == '1770' %}
      max-width: 1770px;
    {% elsif container == '1920' %}
      max-width: 1920px;
    {% elsif container == 'fullwidth' %}
      max-width: 100%;
    {% endif %}
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  /* Main Banner Overlay - Like WhatsApp Banner */
  .section-{{ section.id }} .quality-features-overlay {
    position: relative;
    top: var(--banner-offset-top);
    left: 50%;
    transform: translateX(-50%);
    background: var(--banner-bg-gradient);
    border-radius: var(--banner-border-radius);
    padding: var(--banner-padding);
    text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
    z-index: 10;
    max-width: var(--banner-max-width);
    width: 100%;
    min-width: 300px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    font-family: 'Kumbh Sans', sans-serif;
    overflow: hidden;
  }

  /* Background Pattern for Banner */
  .section-{{ section.id }} .quality-features-overlay::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M26 1h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3V4a3 3 0 00-3-3zM56 1h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3V4a3 3 0 00-3-3zM11 31H4a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM26 31h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM41 31h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM11 16H4a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM41 16h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM56 16h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM26 46h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3zM56 46h-7a3 3 0 00-3 3v7a3 3 0 003 3h7a3 3 0 003-3v-7a3 3 0 00-3-3z' fill='rgba(255,255,255,0.1)'/%3E%3C/svg%3E");
    background-size: 60px 60px;
    opacity: var(--pattern-opacity);
    pointer-events: none;
    z-index: 1;
  }

  .section-{{ section.id }} .quality-features-overlay:hover {
    transform: translateX(-50%) translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .section-{{ section.id }} .quality-banner-content {
    position: relative;
    z-index: 2;
  }

  /* Main Title */
  .section-{{ section.id }} .quality-main-title {
    font-family: 'Kumbh Sans', sans-serif;
    font-size: {{ section.settings.main_title_font_size_desktop | default: 48 }}px;
    font-weight: {{ section.settings.main_title_font_weight | default: 700 }};
    line-height: 1.1;
    margin: 0 0 16px 0;
    color: {{ section.settings.main_title_color | default: '#FFFFFF' }};
    letter-spacing: -0.02em;
  }

  /* Subtitle */
  .section-{{ section.id }} .quality-subtitle {
    font-family: 'Kumbh Sans', sans-serif;
    font-size: {{ section.settings.subtitle_font_size_desktop | default: 18 }}px;
    font-weight: {{ section.settings.subtitle_font_weight | default: 400 }};
    line-height: 1.4;
    margin: 0 0 32px 0;
    color: {{ section.settings.subtitle_color | default: 'rgba(255, 255, 255, 0.9)' }};
  }

  /* Features Grid */
  .section-{{ section.id }} .quality-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .section-{{ section.id }} .quality-feature-item {
    padding: 24px 20px;
    text-align: center;
    position: relative;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.3s ease;
  }

  .section-{{ section.id }} .quality-feature-item:last-child {
    border-right: none;
  }

  .section-{{ section.id }} .quality-feature-item:hover {
    transform: translateY(-2px);
  }

  /* Feature Title */
  .section-{{ section.id }} .feature-title {
    font-family: 'Kumbh Sans', sans-serif;
    font-size: {{ section.settings.feature_title_font_size_desktop | default: 20 }}px;
    font-weight: {{ section.settings.feature_title_font_weight | default: 600 }};
    line-height: 1.3;
    margin: 0 0 8px 0;
    color: {{ section.settings.feature_title_color | default: '#FFFFFF' }};
    letter-spacing: -0.01em;
  }

  /* Feature Description */
  .section-{{ section.id }} .feature-description {
    font-family: 'Kumbh Sans', sans-serif;
    font-size: {{ section.settings.feature_description_font_size_desktop | default: 14 }}px;
    font-weight: {{ section.settings.feature_description_font_weight | default: 400 }};
    line-height: 1.5;
    margin: 0;
    color: {{ section.settings.feature_description_color | default: 'rgba(255, 255, 255, 0.8)' }};
  }

  /* Responsive Design */
  @media screen and (max-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top_tablet }}px;
      margin-bottom: {{ margin_bottom_tablet }}px;
      padding-top: {{ padding_top_tablet }}px;
      padding-bottom: {{ padding_bottom_tablet }}px;
    }

    .section-{{ section.id }} .quality-features-overlay {
      max-width: 94%;
      min-width: 280px;
      padding: calc(var(--banner-padding) - 8px);
    }

    .section-{{ section.id }} .quality-main-title {
      font-size: {{ section.settings.main_title_font_size_tablet | default: 40 }}px;
    }

    .section-{{ section.id }} .quality-subtitle {
      font-size: {{ section.settings.subtitle_font_size_tablet | default: 16 }}px;
      margin-bottom: 24px;
    }

    .section-{{ section.id }} .feature-title {
      font-size: {{ section.settings.feature_title_font_size_tablet | default: 18 }}px;
    }

    .section-{{ section.id }} .feature-description {
      font-size: {{ section.settings.feature_description_font_size_tablet | default: 13 }}px;
    }

    .section-{{ section.id }} .quality-feature-item {
      padding: 20px 16px;
    }
  }

  @media screen and (max-width: 768px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top_mobile }}px;
      margin-bottom: {{ margin_bottom_mobile }}px;
      padding-top: {{ padding_top_mobile }}px;
      padding-bottom: {{ padding_bottom_mobile }}px;
    }

    .section-{{ section.id }} .quality-features-overlay {
      max-width: 90%;
      min-width: 250px;
      padding: calc(var(--banner-padding) - 12px);
      top: calc(var(--banner-offset-top) + 10px);
    }

    .section-{{ section.id }} .quality-main-title {
      font-size: {{ section.settings.main_title_font_size_mobile | default: 32 }}px;
      margin-bottom: 12px;
    }

    .section-{{ section.id }} .quality-subtitle {
      font-size: {{ section.settings.subtitle_font_size_mobile | default: 15 }}px;
      margin-bottom: 20px;
    }

    .section-{{ section.id }} .quality-features-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .section-{{ section.id }} .quality-feature-item {
      padding: 16px 12px;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .section-{{ section.id }} .quality-feature-item:last-child {
      border-bottom: none;
    }

    .section-{{ section.id }} .feature-title {
      font-size: {{ section.settings.feature_title_font_size_mobile | default: 16 }}px;
    }

    .section-{{ section.id }} .feature-description {
      font-size: {{ section.settings.feature_description_font_size_mobile | default: 12 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .section-{{ section.id }} .quality-banner-container {
      padding: 0 16px;
    }

    .section-{{ section.id }} .quality-features-overlay {
      max-width: 95%;
      min-width: 200px;
      padding: calc(var(--banner-padding) - 16px);
      border-radius: calc(var(--banner-border-radius) - 2px);
      top: calc(var(--banner-offset-top) + 8px);
    }

    .section-{{ section.id }} .quality-main-title {
      font-size: {{ section.settings.main_title_font_size_mobile | default: 32 | minus: 4 }}px;
    }

    .section-{{ section.id }} .quality-feature-item {
      padding: 14px 10px;
    }
  }

  /* Ultra-small screens */
  @media screen and (max-width: 360px) {
    .section-{{ section.id }} .quality-features-overlay {
      max-width: 98%;
      min-width: 180px;
      padding: calc(var(--banner-padding) - 18px);
      border-radius: calc(var(--banner-border-radius) - 4px);
    }

    .section-{{ section.id }} .quality-feature-item {
      padding: 12px 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .quality-feature-item {
      transition: none;
    }

    .section-{{ section.id }} .quality-feature-item:hover {
      transform: none;
    }

    .section-{{ section.id }} .quality-features-overlay {
      transition: none;
    }

    .section-{{ section.id }} .quality-features-overlay:hover {
      transform: translateX(-50%);
    }
  }
</style>

{% schema %}
{
