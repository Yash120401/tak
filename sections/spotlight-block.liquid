{%- if section.blocks.size > 0 -%}
  {%- assign swipe = section.settings.spotlight_block_swipe_on_mobile -%}
  {%- assign position_horizontal_slick_arrow = section.settings.position_horizontal_slick_arrow -%}
  <link
    rel="stylesheet"
    href="{{ 'component-spotlight-block.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
  <noscript>{{ 'component-spotlight-block.css' | asset_url | stylesheet_tag }}</noscript>

  <div
    class="spotlight-block takkl-spotlight-responsive section-block-{{section.id}}{% if section.settings.block_layout == 'slider' %} enable_slider{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
    id="spotlight-{{section.id}}"
    {% if section.settings.block_layout == 'slider' %}
      data-loader-script="{{ 'halo.slide-spotlight.js' | asset_url }}"
    {% endif %}
  >
    <div class="{% if section.settings.container == 'fullwidth' %}container-full{% elsif section.settings.container == '1770' %}container-1770 {% elsif section.settings.container == '1570'%}container-1570 {% elsif section.settings.container == '1470'%}container-1470 {% else %}{% if section.settings.container == '1200' %}layout--special{% endif %} container{% endif %}{% if section.settings.enable_custom_position_title %} enable_po_title{% endif %}">
      {%- if section.settings.spotlight_block_title != blank -%}
        <div class="halo-block-header text-{{ section.settings.title_align }}{% if section.settings.view_all != blank %} viewAll--{{ section.settings.view_all_align }}{% endif %}">
          <h2
            class="title{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
            style="--margin-bottom-title: {{ section.settings.margin_bottom_title | append: 'px' }}"
          >
            <span class="text">{{ section.settings.spotlight_block_title }}</span>
          </h2>
          {%- if section.settings.spotlight_block_des != blank -%}
            <div
              class="rte subtext-spotlight"
              style="--margin-bottom-des: {{ section.settings.margin_bottom_des | append: 'px' }}"
            >
              {{ section.settings.spotlight_block_des }}
            </div>
          {%- endif -%}
          {%- if section.settings.view_all != blank -%}
            <a
              class="view_all{% if section.settings.enable_border_view_all %} has-border{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}{% if section.settings.view_all_style == 'style_2' %} button button-1{% endif %}"
              {% if section.settings.link_view_all == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.link_view_all }}"
              {% endif %}
              title="{{section.settings.view_all}}"
              style="--font-weight-view-all-style: {{ section.settings.font_weight_view_all }};--mg-bottom-view-style: {{ section.settings.mg_bottom_view | append: 'px' }};--color-view-all-style: {{ section.settings.color_view_all }};--font-size-view-all-style: {{ section.settings.view_all_fs | append: 'px' }}"
            >
              {{- section.settings.view_all -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if swipe == 'slider' and section.settings.block_layout == 'grid' -%}
        <banner-slider-component>
      {%- endif -%}

      {%- if section.settings.display_spotlight_button
        and section.settings.button_position == 'top'
        and section.settings.spotlight_button_text != blank
      -%}
        <div class="group-btn top">
          <a
            {% if section.settings.spotlight_button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.spotlight_button_link }}"
            {% endif %}
            title="{{ section.settings.spotlight_button_text | split: '|' | first }}"
            class="btn button"
          >
            {{- section.settings.spotlight_button_text -}}
          </a>
        </div>
      {%- endif -%}

      <div
        class="halo-row takkl-spotlight-grid column-{{ section.settings.column }}{% if swipe == 'slider' and section.settings.block_layout == 'grid' %} slider slider--tablet{% endif %}{% if section.settings.item_distance == 0 %} not-distance{% endif %}{% if swipe == 'scroll' and section.settings.block_layout == 'grid' %} scroll-snap-mobile disable-srollbar{% endif %}{% if section.settings.column_mb == '2' %} column-mb-2{% endif %}{% if section.settings.container == '1320' %} width-1320{% endif %}{% if section.settings.display_spotlight_button %} button-bottom{% endif %}{% if section.settings.block_layout == 'grid' %} block-layout-grid{% endif %}"
        style="--animation-items: {{ section.blocks.size }};--row-distance-style: {{ section.settings.item_distance | prepend: '-' | append: 'px' }};--arrow-side-position: {{ position_horizontal_slick_arrow }}"
        {% if section.settings.block_layout == 'slider' %}
          data-spotlight-slider data-rows="{{section.settings.column}}"
          data-arrows="{{ section.settings.enable_arrows }}" data-arrows-mb="{{ section.settings.enable_arrows_mb }}"
          data-rows-mb="{{ section.settings.column_mb }}"
        {% endif %}
        data-swipe="{{ swipe }}"
        data-dots="{{ section.settings.enable_dots }}"
        data-dots-mb="{{ section.settings.enable_dots_mb }}"
        data-center-mode="{{ section.settings.center_mode }}"
      >
        {%- for block in section.blocks -%}
          <div
            class="halo-item{% if swipe == 'slider' and section.settings.block_layout == 'grid' %} slider__slide{% endif %} spotlight--{{ block.type }}{% if section.settings.enable_plus_icon %} enable_plus_icon{% endif %} takkl-spotlight-item"
            id="block-{{block.id}}"
            style="--item-distance-style: {{ section.settings.item_distance | append: 'px' }};"
          >
            <div
              class="spotlight-item spotlight-item__{{block.type}}{% if block.settings.enable_absolute and block.settings.enable_image %} content_absolute{% endif %}{% if block.settings.border_color_title != blank and block.settings.border_color_title != 'rgba(0,0,0,0)' %} enable_border_color{% endif %}{% if block.settings.enable_des_hover %} enable_des_hover{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.banner_animation == 'effect_fade_up' %}
                data-cascade style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {%- if block.settings.enable_image -%}
                <div class="image-container takkl-image-container">
                  <div class="img-box{% if block.settings.image_behavior != 'none' %} animate--{{ block.settings.image_behavior }} o-hidden{% endif %}">
                    {%- if block.settings.image != blank -%}
                      {%- assign preview_img = block.settings.image -%}
                      <a
                        {% if block.settings.link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.link }}"
                        {% endif %}
                        class="image-zoom adaptive_height image"
                        style="padding-top: {% unless preview_img.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: preview_img.aspect_ratio | times: 120 | append: '%' }}{% else %}{{ 1 | divided_by: preview_img.aspect_ratio | times: 100 | append: '%' }}{% endunless %}"
                        title="{{ block.settings.title | default: shop.name | escape  }}"
                      >
                        <img
                          {% render 'lazyload', preview_img: preview_img, enable_rtl: settings.enable_layout_rtl -%}
                          {% unless preview_img.presentation.focal_point == '50.0% 50.0%' %}
                            style="object-position: {{ preview_img.presentation.focal_point }}"
                          {% endunless %}
                        >
                        {% if settings.enable_lazyload %}<span class="data-lazy-loading"></span>{% endif %}
                      </a>
                    {%- else -%}
                      <a
                        {% if block.settings.link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.link }}"
                        {% endif %}
                        class="image-zoom image"
                        title="{{ block.settings.title | default: shop.name | escape  }}"
                      >
                        {% if block.settings.enable_absolute %}
                          {% if section.settings.enable_custom_position_title %}
                            <div
                              class="placeholder"
                              style="--height_placeholder: clamp(300px, calc(600 / 1920 * 100vw), 600px);"
                            >
                              {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {% else %}
                            <div
                              class="placeholder"
                              style="--height_placeholder: clamp(250px, calc(400 / 1920 * 100vw), 400px);"
                            >
                              {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                          {% endif %}
                        {% else %}
                          {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
                          {%- assign placeholder_image = 'product-apparel-' | append: placeholder_image_index -%}
                          <div
                            class="placeholder"
                            style="--height_placeholder: clamp(200px, calc(300 / 1920 * 100vw), 300px);"
                          >
                            {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {% endif %}
                      </a>
                    {%- endif -%}
                    {%- if section.settings.enable_plus_icon -%}
                      <span
                        class="show-icon-more"
                        style="--color-icon-plus: {{ section.settings.color_plus_icon }}"
                      ></span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

              {%- if block.settings.sub_title != blank
                or block.settings.title != blank
                or block.settings.des != blank
                or block.settings.button != blank
              -%}
                <div
                  class="content spotlight-inner takkl-spotlight-content text-{{block.settings.title_align}} align-items--{{block.settings.align_items}}{% if section.settings.enable_content_border %} is-bordered{% endif %}{% if block.settings.title == blank and block.settings.des == blank %} not_title_des{% endif %}{% unless block.settings.enable_image %} not-image{% endunless %}{% if block.settings.border_color_button == 'rgba(0,0,0,0)' and block.settings.bg_color_button == 'rgba(0,0,0,0)' %} enable-transparnet{% endif %}{% if block.settings.font_weight_title == '400' %} spotlight-inner--border-light{% endif %}{% if block.settings.button_style == 'button_2' %} button_style_2{% elsif block.settings.button_style == 'button_3' %} button_style_3{% endif %}{% if block.settings.mg_top_des == 10 %} spotlight_inder_des_10{% endif %}{% if block.settings.align_items_spacing_lr == 60 %} items_lr_60{% endif %}{% if block.settings.enable_button_hover %} enable-button-hover{% endif %}"
                  style="--align-items-spacing-top-style: {{ block.settings.align_items_spacing_top | append: 'px' }}; --align-items-spacing-bottom-style: {{ block.settings.align_items_spacing_bottom | append: 'px' }}; --align-items-spacing-lr-style: {{ block.settings.align_items_spacing_lr | append: 'px' }};--align-items-postion-content-style: {{ block.settings.align_items_spacing_top_bottom_position | append: 'px' }};--align-items-postion-content-mb-style: {{ block.settings.align_items_spacing_top_bottom_position_mb | append: 'px' }};--bg_color_content: {{ block.settings.bg_color_content }};--content-border-color: {% if section.settings.content_border_color != blank and section.settings.content_border_color != 'rgba(0,0,0,0)' %}{{ section.settings.content_border_color }}{% endif %}"
                >
                  {%- if block.settings.sub_title != blank -%}
                    <p
                      class="sub_title custom-text-style{% if block.settings.border_sub_title %} has-border{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                      style="{% if settings.banner_animation == 'effect_fade_up' %}--animation-order: 0;{% endif %}--color-text-style: {{ block.settings.color_sub_title }};--fontsize-text-style: {{ block.settings.fontsize_sub_title | append: 'px' }};--font-weight-text-style: {{ block.settings.font_weight_sub_title }};--mg-bottom-sub-title-style: {{ block.settings.mg_bottom_sub_title | append: 'px' }}"
                    >
                      <span>{{ block.settings.sub_title }}</span>
                    </p>
                  {%- endif -%}

                  {%- if block.settings.title != blank -%}
                    <h3
                      class="title custom-text-style has--{{ block.settings.border_title }}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                      style="
                        {% if settings.banner_animation == 'effect_fade_up' %}--animation-order: 1;{% endif %}--color-text-style: {{ block.settings.color_title }};--fontsize-text-style: {{ block.settings.fontsize_title | append: 'px' }};--fontsize-mobile-text-style: {{ block.settings.fontsize_title_mb | append: 'px' }};--title-font-weight: {{block.settings.font_weight_title}};--font-text-style: {%- if block.settings.enable_style_italic -%}italic{%- else -%}normal{%- endif -%};
                            {%- if block.settings.border_title == 'border_s1' -%}
                                padding-bottom: 7px;border-bottom: 3px solid {{ block.settings.border_color_title }};
                            {%- elsif block.settings.border_title == 'border_hover' or block.settings.border_title == 'border_s2' -%}
                                --border-color-title-style: {{ block.settings.border_color_title }};
                            {%- elsif block.settings.border_title == 'none' -%}
                                --border-color-title-style: transparent;
                                {% elsif  block.settings.border_title == 'border_s3' %}
                                --border-color-title-style: transparent;padding-bottom: 22px;
                        {%- endif -%}
                      "
                    >
                      <a
                        {% if block.settings.link == blank %}
                          role="link" aria-disabled="true"
                        {% else %}
                          href="{{ block.settings.link }}"
                        {% endif %}
                        class="link_title{% if block.settings.border_title == 'border_s3' %} has_border_s3{% endif %}"
                        {% if block.settings.border_title == 'border_s3' %}
                          style="--border-color-title-style-3: {{ block.settings.border_color_title }};"
                        {% endif %}
                        ><span>{{ block.settings.title }}</span></a
                      >
                    </h3>
                  {%- endif -%}

                  {%- if block.settings.des != blank -%}
                    <div
                      class="des custom-text-style{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                      style="{% if settings.banner_animation == 'effect_fade_up' %}--animation-order: 2;{% endif %}--color-text-style: {{ block.settings.color_des }};--fontsize-text-style: {{ block.settings.fontsize_des | append: 'px' }};--margin-top-des-style: {{ block.settings.mg_top_des | append: 'px' }}"
                    >
                      {{ block.settings.des }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button != blank -%}
                    {% if settings.banner_animation == 'effect_fade_up' %}
                      <div class="scroll-trigger animate--slide-in" style="--animation-order: 3;">
                    {% endif %}
                    <a
                      {% if block.settings.link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.link }}"
                      {% endif %}
                      class="spotlight-button button custom-button-style{% if block.settings.enable_button_custom_border %} enable-button-custom-border{% endif %}{% if block.settings.border_color_button == 'rgba(0,0,0,0)' and block.settings.bg_color_button == 'rgba(0,0,0,0)' %} enable-transparnet{% endif %}"
                      style="--color-button-style: {{ block.settings.color_button }}; --bg-color-button-style: {% if block.settings.bg_color_button_gradient != blank %}{{ block.settings.bg_color_button_gradient }}{% else %}{{ block.settings.bg_color_button | color_modify: 'alpha', block.settings.bg_opacity_button }}{% endif %}; --border-color-button-style: {{ block.settings.border_color_button }}; --color-button-hover-style: {{ block.settings.color_button_hover }}; --bg-color-button-hover-style: {% if block.settings.bg_color_button_gradient_hover != blank %}{{ block.settings.bg_color_button_gradient_hover }}{% else %}{{ block.settings.bg_color_button_hover }}{% endif %}; --border-color-button-hover-style: {{ block.settings.border_color_button_hover }}; --text-transform-button-style: {{block.settings.btn_text_transform}}; --font-size-button-style: {{block.settings.fontsize_btn | append: 'px' }}; --margin-top-button-style: {{block.settings.mg_top_btn | append: 'px' }}; --button-width-style: {{block.settings.button_width | append: 'px' }}"
                    >
                      {%- if block.settings.btn_icon != blank and block.settings.button_style != 'button_3' -%}
                        {{ block.settings.btn_icon }}
                      {%- endif -%}
                      <span>{{ block.settings.button }}</span>
                      {%- if block.settings.button_style == 'button_3' -%}
                        {{ block.settings.btn_icon }}
                      {%- endif -%}
                    </a>
                    {% if settings.banner_animation == 'effect_fade_up' %}
                      </div>
                    {% endif %}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if swipe == 'slider' and section.blocks.size > 1 and section.settings.block_layout == 'grid' -%}
        <div class="slider-buttons no-js-hidden">
          <ul class="slider-dots {% if section.blocks.size == 2 %}count_2{% endif %}">
            {%- for block in section.blocks -%}
              <li class="dots-item {% if forloop.first %}active{% endif %}">
                <button name="dots" data-index="{{ forloop.index0 }}">{{ forloop.index }}</button>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.display_spotlight_button
        and section.settings.button_position == 'bottom'
        and section.settings.spotlight_button_text != blank
      -%}
        <div class="group-btn">
          <a
            {% if section.settings.spotlight_button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.spotlight_button_link }}"
            {% endif %}
            title="{{ section.settings.spotlight_button_text | split: '|' | first }}"
            class="btn button"
          >
            {{- section.settings.spotlight_button_text -}}
          </a>
        </div>
      {%- endif -%}

      {%- if swipe == 'slider' and section.settings.block_layout == 'grid' -%}
        </banner-slider-component>
      {%- endif -%}
    </div>
  </div>

  <style>
    {%- liquid
        assign spotlight_bg = section.settings.spotlight_bg
        assign spotlight_bg_gradient = section.settings.spotlight_bg_gradient
        assign spotlight_bg_image = section.settings.spotlight_bg_image

        assign color_title = section.settings.color_title
        assign color_title_mb = section.settings.color_title_mb
        assign fontsize_title = section.settings.fontsize_title
        assign fontsize_title_mb = section.settings.fontsize_title_mb

        assign color_des = section.settings.color_des
        assign fontsize_des = section.settings.fontsize_des

        assign mg_top_desktop = section.settings.mg_top_desktop
        assign mg_top_tablet = section.settings.mg_top_tablet
        assign mg_top_mobile = section.settings.mg_top_mobile

        assign mg_bottom_desktop = section.settings.mg_bottom_desktop
        assign mg_bottom_tablet = section.settings.mg_bottom_tablet
        assign mg_bottom_mobile = section.settings.mg_bottom_mobile

        assign padding_full_width = section.settings.padding_full_width
        assign item_radius = section.settings.item_radius

        assign mg_minus_desktop = section.settings.mg_minus_desktop

        assign color_button = section.settings.color_button
        assign bg_color_button = section.settings.bg_color_button
        assign border_color_button = section.settings.border_color_button
        assign bg_color_gradient_button = section.settings.bg_color_gradient_button

        assign color_button_hover = section.settings.color_button_hover
        assign bg_color_button_hover = section.settings.bg_color_button_hover
        assign border_color_button_hover = section.settings.border_color_button_hover
        assign bg_color_gradient_button_hover = section.settings.bg_color_gradient_button_hover

        assign maxwidth_button = section.settings.maxwidth_button
        assign mg_top_button = section.settings.mg_top_button
        assign mg_bottom_button = section.settings.mg_bottom_button
        assign enable_border_title = section.settings.enable_border_title
    -%}

    /* TAKKL Spotlight Responsive Styles */
    .takkl-spotlight-responsive {
        position: relative;
    }

    .section-block-{{section.id}} {
        {%- if section.settings.display_border_bottom -%}border-bottom: 1px solid {{ section.settings.border_color }};{%- endif -%}
        padding-top: {{ mg_minus_desktop | times: 0.5 | append: 'px' }};
    }

    .section-block-{{section.id}} .halo-block-header {
        margin-top: -{{ mg_minus_desktop | append: 'px' }};
    }

    {%- if spotlight_bg_image != blank -%}
        .section-block-{{section.id}} {
            background: url({{ spotlight_bg_image | img_url: '1920x' }});
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }
        .section-block-{{section.id}} .halo-block-header .title .text {
            background-color: transparent;
        }
    {%- else -%}
        .section-block-{{section.id}}, .section-block-{{section.id}} .halo-block-header .title .text {
            background: {% if spotlight_bg_gradient != blank %}{{ spotlight_bg_gradient }}{% else %}{{ spotlight_bg }}{% endif %};
        }
    {%- endif -%}

    {%- unless enable_border_title -%}
    .section-block-{{section.id}} .halo-block-header .title .text {
        background-color: transparent;
    }
    {%- endunless -%}

    .section-block-{{section.id}} .halo-block-header .title:before {
        background-color: {{ color_title }};
        {%- unless enable_border_title -%}display: none;{%- endunless -%}
    }

    .section-block-{{section.id}} .halo-block-header .title {
        color: {{ color_title }};
        font-size: {{ fontsize_title | append: 'px' }};
        line-height: 1.3;
        font-weight: 700;
        text-align: center;
        {%- if enable_border_title -%}display: block;{%- endif -%}
    }

    .section-block-{{section.id}} .halo-block-header .rte {
        color: {{ color_des }};
        font-size: {{ fontsize_des | append: 'px' }};
        line-height: {{ fontsize_des | plus: 8 | append: 'px' }};
        text-align: center;
        margin-bottom: var(--margin-bottom-des);
    }

    .section-block-{{section.id}} .view_all {
        font-weight: var(--font-weight-view-all-style);
        margin-bottom: var(--mg-bottom-view-style);
        color: var(--color-view-all-style);
        font-size: var(--font-size-view-all-style);
    }

    .section-block-{{section.id}} .view_all:not(.has-border) {
        border-bottom: none;
    }

    .section-block-{{section.id}} .view_all.has-border {
        border-bottom: 1px solid;
    }

    /* TAKKL Responsive Grid Layout */
    .section-block-{{section.id}} .takkl-spotlight-grid {
        display: grid;
        gap: {{ section.settings.item_distance | append: 'px' }};
        grid-template-columns: repeat({{ section.settings.column }}, 1fr);
    }

    .section-block-{{section.id}} .takkl-spotlight-item {
        position: relative;
    }

    .section-block-{{section.id}} .spotlight-item {
        height: 100%;
        display: flex;
        flex-direction: column;
        border-radius: {{ item_radius | append: 'px' }};
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .section-block-{{section.id}} .takkl-image-container {
        position: relative;
        overflow: hidden;
        border-radius: {{ item_radius | append: 'px' }};
    }

    .section-block-{{section.id}} .img-box a {
        border-radius: {{ item_radius | append: 'px' }};
        display: block;
        transition: transform 0.3s ease;
    }

    .section-block-{{section.id}} .takkl-spotlight-content {
        flex-grow: 1;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .section-block-{{section.id}} .custom-text-style.title {
        font-size: clamp(18px, 2.5vw, 24px);
        font-weight: 600;
        margin-bottom: 12px;
        line-height: 1.3;
    }

    .section-block-{{section.id}} .custom-text-style.des {
        font-size: clamp(14px, 1.8vw, 16px);
        line-height: 1.5;
        color: #666;
        margin-bottom: 16px;
        flex-grow: 1;
    }

    .section-block-{{section.id}} .spotlight-button {
        display: inline-block;
        padding: 12px 24px;
        background: #FFB800;
        color: #333;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        text-align: center;
        transition: all 0.3s ease;
        text-transform: var(--text-transform-button-style);
        font-size: var(--font-size-button-style);
        margin-top: var(--margin-top-button-style);
        max-width: var(--button-width-style);
    }

    .section-block-{{section.id}} .spotlight-button:hover {
        background: #e6a500;
        transform: translateY(-2px);
    }

    {%- if section.settings.enable_shadow and section.settings.shadow_color != 'rgba(0,0,0,0)' and section.settings.shadow_color != blank -%}
        {% liquid
            assign boxX = section.settings.shadow_horizontal_length | append: 'px'
            assign boxY = section.settings.shadow_vertical_length | append: 'px'
            assign boxBlur = section.settings.shadow_blur_radius | append: 'px'
            assign boxSpread = section.settings.shadow_spread | append: 'px'
            assign boxColor = section.settings.shadow_color
            assign boxInset = section.settings.shadow_inset
        %}
        .section-block-{{section.id}} .halo-item .spotlight-item {
            box-shadow: {{ boxX }} {{ boxY }} {{ boxBlur }} {{ boxSpread }} {{ boxColor }} {% if boxInset == 'inset' %}inset{% endif %};
        }
    {%- endif -%}

    {%- if section.settings.display_spotlight_button -%}
        .section-block-{{section.id}} .group-btn {
            margin-top: {{ mg_top_button | append: 'px' }};
            margin-bottom: {{ mg_bottom_button | append: 'px' }};
            text-align: center;
        }

        .section-block-{{section.id}} a.button {
            max-width: {{ maxwidth_button | append: 'px' }};
        }

        .section-block-{{section.id}} a.btn,.section-block-{{section.id}} a.btn-2:hover {
            background: {% if bg_color_gradient_button != blank %}{{ bg_color_gradient_button }}{% else %}{{ bg_color_button }}{% endif %};
            color: {{ color_button }};
            border: 1px solid {{ border_color_button }};
        }

        .section-block-{{section.id}} a.btn:hover,.section-block-{{section.id}} a.btn-2 {
            background-color: {% if bg_color_gradient_button_hover != blank %}{{ bg_color_gradient_button_hover }}{% else %}{{ bg_color_button_hover }}{% endif %};
            color: {{ color_button_hover }};
            border: 1px solid {{ border_color_button_hover }};
        }
    {%- endif -%}

    {%- if section.settings.enable_plus_icon -%}
        .section-block-{{ section.id }} .image-container {
            position: relative;
        }
    {%- endif -%}

    /* Responsive Design */
    @media (min-width: 1200px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_desktop | append: 'px' }};
            padding-bottom: {{ mg_bottom_desktop | append: 'px' }};
        }

        .section-block-{{section.id}} .takkl-spotlight-grid {
            gap: 30px;
        }

        .section-block-{{section.id}} .takkl-spotlight-content {
            padding: 30px;
        }

        .section-block-{{section.id}} .spotlight-item:hover {
            transform: translateY(-8px);
        }

        .section-block-{{section.id}} .img-box:hover a {
            transform: scale(1.05);
        }
    }

    @media (min-width: 1025px) {
        {%- if section.settings.container == 'fullwidth' -%}
            {%- if section.settings.disable_padding_content -%}
                .section-block-{{section.id}} .container-full .halo-block-header {
                    margin-left: {{ padding_full_width | append: 'px' }};
                    margin-right: {{ padding_full_width | append: 'px' }};
                }
            {%- else -%}
                .section-block-{{section.id}} .container-full {
                    padding-left: {{ padding_full_width | append: 'px' }};
                    padding-right: {{ padding_full_width | append: 'px' }};
                }
            {%- endif -%}
        {%- elsif section.settings.container == '1200' -%}
            .section-block-{{section.id}} .container {
                max-width: 1200px !important;
            }
        {%- endif -%}

        {%- unless enable_border_title -%}
            .section-block-{{section.id}} .halo-block-header .title .text {
                width: auto;
            }
        {%- endunless -%}
    }

    @media (min-width: 768px) and (max-width: 1199px) {
        .section-block-{{section.id}} {
            padding-top: {{ mg_top_tablet | append: 'px' }};
            padding-bottom: {{ mg_bottom_tablet | append: 'px' }};
        }

        .section-block-{{section.id}} .takkl-spotlight-grid {
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .section-block-{{section.id}} .takkl-spotlight-content {
            padding: 25px;
        }
    }

    @media (max-width: 1024px) {
        {%- if spotlight_bg_image != blank -%}
            .section-block-{{section.id}} {
                background-position: center top;
            }
        {%- endif -%}

        {%- if section.settings.disable_padding_content -%}
            .section-block-{{section.id}} .container-full .halo-block-header {
                padding-left: 15px;
                padding-right: 15px;
            }
        {%- endif -%}

        {%- if section.settings.container == 'fullwidth' -%}
            .section-block-{{section.id}} .container-full {
                padding-left: 15px;
                padding-right: 15px;
            }
            {%- if padding_full_width == 0 -%}
                .section-block-{{section.id}} .container-full {
                    padding-left: 0;
                    padding-right: 0;
                }
            {%- endif -%}
        {%- endif -%}

        .section-block-{{section.id}} .halo-block-header .title {
            font-size: {{ fontsize_title_mb | append: 'px' }} !important;
        }
    }

    @media (max-width: 992px) {
        {%- if color_title_mb != blank -%}
            .section-block-{{section.id}} .halo-block-header .title {
                color: {{ color_title_mb }};
            }
        {%- endif -%}
    }

    @media (max-width: 767px) {
        {%- if section.settings.container == 'fullwidth' -%}
            .section-block-{{section.id}} .container-full {
                padding-left: 15px;
                padding-right: 15px;
            }
            {%- if padding_full_width == 0 -%}
                .section-block-{{section.id}} .container-full {
                    padding-left: 10px;
                    padding-right: 10px;
                }
            {%- endif -%}
        {%- endif -%}

        .section-block-{{section.id}} {
            padding-top: {{ mg_top_mobile | append: 'px' }};
            padding-bottom: {{ mg_bottom_mobile | append: 'px' }};
        }

        .section-block-{{section.id}} .takkl-spotlight-grid {
            {% if section.settings.column_mb == '2' %}
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            {% else %}
                grid-template-columns: 1fr;
                gap: 20px;
            {% endif %}
        }

        .section-block-{{section.id}} .takkl-spotlight-content {
            padding: 20px 15px;
        }

        .section-block-{{section.id}} .custom-text-style.title {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .section-block-{{section.id}} .custom-text-style.des {
            font-size: 14px;
            margin-bottom: 12px;
        }

        .section-block-{{section.id}} .spotlight-button {
            padding: 10px 20px;
            font-size: 14px;
            width: 100%;
            text-align: center;
        }

        {%- if mg_top_button > 40 -%}
            .section-block-{{section.id}} .group-btn {
                margin-top: 30px;
            }
        {%- endif -%}

        {%- if mg_bottom_button > 60 -%}
            .section-block-{{section.id}} .group-btn {
                margin-bottom: 40px;
            }
        {%- endif -%}

        {%- if section.settings.view_all_style == 'style_2' -%}
            .section-block-{{section.id}} .halo-block-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 15px;
            }

            .section-block-{{section.id}} .halo-block-header .title {
                margin-bottom: 0;
                margin-top: 0;
                flex-grow: 1;
            }
        {%- endif -%}
    }

    /* Mobile Slider Styles */
    {%- if swipe == 'slider' -%}
        @media (max-width: 1024px) {
            .section-block-{{section.id}} .takkl-spotlight-grid.slider {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                gap: 20px;
                padding-bottom: 20px;
                grid-template-columns: none;
            }

            .section-block-{{section.id}} .takkl-spotlight-grid.slider .takkl-spotlight-item {
                flex: 0 0 280px;
                scroll-snap-align: start;
            }
        }

        @media (max-width: 767px) {
            .section-block-{{section.id}} .takkl-spotlight-grid.slider .takkl-spotlight-item {
                flex: 0 0 250px;
            }
        }
    {%- endif -%}

    {%- if swipe == 'scroll' -%}
        @media (max-width: 1024px) {
            .section-block-{{section.id}} .takkl-spotlight-grid.scroll-snap-mobile {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                gap: 20px;
                padding-bottom: 20px;
                scrollbar-width: none;
                -ms-overflow-style: none;
                grid-template-columns: none;
            }

            .section-block-{{section.id}} .takkl-spotlight-grid.scroll-snap-mobile::-webkit-scrollbar {
                display: none;
            }

            .section-block-{{section.id}} .takkl-spotlight-grid.scroll-snap-mobile .takkl-spotlight-item {
                flex: 0 0 280px;
                scroll-snap-align: start;
            }
        }

        @media (max-width: 767px) {
            .section-block-{{section.id}} .takkl-spotlight-grid.scroll-snap-mobile .takkl-spotlight-item {
                flex: 0 0 250px;
            }
        }
    {%- endif -%}

    @media (max-width: 551px) {
        {%- if section.settings.disable_padding_content -%}
            .section-block-{{section.id}} .container-full .halo-block-header {
                padding-left: 10px;
                padding-right: 10px;
            }
        {%- endif -%}

        .section-block-{{section.id}} .takkl-spotlight-content {
            padding: 15px 10px;
        }

        .section-block-{{section.id}} .custom-text-style.title {
            font-size: 16px;
        }

        .section-block-{{section.id}} .custom-text-style.des {
            font-size: 13px;
        }
    }
  </style>
{%- endif -%}

{% schema %}
