to
{%- liquid
  assign container = section.settings.container
  assign section_title = section.settings.section_title
  assign section_description = section.settings.section_description
  assign layout_direction = section.settings.layout_direction
  assign content_alignment = section.settings.content_alignment

  assign title_color = section.settings.title_color
  assign title_font_size = section.settings.title_font_size
  assign title_font_size_mobile = section.settings.title_font_size_mobile
  assign title_font_weight = section.settings.title_font_weight
  assign title_margin_bottom = section.settings.title_margin_bottom

  assign desc_color = section.settings.desc_color
  assign desc_font_size = section.settings.desc_font_size
  assign desc_font_size_mobile = section.settings.desc_font_size_mobile
  assign desc_line_height = section.settings.desc_line_height
  assign desc_margin_bottom = section.settings.desc_margin_bottom

  assign country_bg_color = section.settings.country_bg_color
  assign country_text_color = section.settings.country_text_color
  assign country_border_color = section.settings.country_border_color
  assign country_bg_hover = section.settings.country_bg_hover
  assign country_text_hover = section.settings.country_text_hover
  assign country_border_hover = section.settings.country_border_hover

  assign map_default_color = section.settings.map_default_color
  assign map_highlight_color = section.settings.map_highlight_color
  assign map_hover_color = section.settings.map_hover_color
  assign map_bg_color = section.settings.map_bg_color

  assign section_bg_color = section.settings.section_bg_color
  assign section_bg_gradient = section.settings.section_bg_gradient
  assign content_bg_color = section.settings.content_bg_color
  assign content_bg_gradient = section.settings.content_bg_gradient

  assign mg_top_desktop = section.settings.mg_top_desktop
  assign mg_top_tablet = section.settings.mg_top_tablet
  assign mg_top_mobile = section.settings.mg_top_mobile
  assign mg_bottom_desktop = section.settings.mg_bottom_desktop
  assign mg_bottom_tablet = section.settings.mg_bottom_tablet
  assign mg_bottom_mobile = section.settings.mg_bottom_mobile

  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_left = section.settings.padding_left
  assign padding_right = section.settings.padding_right

  assign mobile_padding_top = section.settings.mobile_padding_top
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom
  assign mobile_padding_left = section.settings.mobile_padding_left
  assign mobile_padding_right = section.settings.mobile_padding_right

  assign content_width_desktop = section.settings.content_width_desktop
  assign map_width_desktop = section.settings.map_width_desktop
  assign content_width_tablet = section.settings.content_width_tablet
  assign map_width_tablet = section.settings.map_width_tablet

  assign enable_animation = section.settings.enable_animation
  assign animation_type = section.settings.animation_type

  assign custom_map_svg = section.settings.custom_map_svg
  assign use_custom_map = section.settings.use_custom_map
-%}

<style>
    #global-reach-{{ section.id }} {
      margin-top: var(--mg-top-desktop);
      margin-bottom: var(--mg-bottom-desktop);
      {% if section_bg_gradient != blank %}
        background: {{ section_bg_gradient }};
      {% elsif section_bg_color != blank %}
        background-color: {{ section_bg_color }};
      {% endif %}
    }

    #global-reach-{{ section.id }} .global-reach-wrapper {
      padding: {{ padding_top }}px {{ padding_right }}px {{ padding_bottom }}px {{ padding_left }}px;
      {% if content_bg_gradient != blank %}
        background: {{ content_bg_gradient }};
      {% elsif content_bg_color != blank %}
        background-color: {{ content_bg_color }};
      {% endif %}
    }

    #global-reach-{{ section.id }} .global-reach-content {
      flex: 0 0 {{ content_width_desktop }}%;
      max-width: {{ content_width_desktop }}%;
    }

    #global-reach-{{ section.id }} .global-reach-map {
      flex: 0 0 {{ map_width_desktop }}%;
      max-width: {{ map_width_desktop }}%;
    }

    #global-reach-{{ section.id }} .section-title {
      color: {{ title_color }};
      font-size: {{ title_font_size }}px;
      font-weight: {{ title_font_weight }};
      margin-bottom: {{ title_margin_bottom }}px;
      margin-top: 0;
      line-height: 1.2;
    }

    #global-reach-{{ section.id }} .section-description {
      color: {{ desc_color }};
      font-size: {{ desc_font_size }}px;
      line-height: {{ desc_line_height }};
      margin-bottom: {{ desc_margin_bottom }}px;
      margin-top: 0;
    }

    #global-reach-{{ section.id }} .country-tag {
      display: inline-block;
      padding: 8px 16px;
      margin: 4px 8px 4px 0;
      background-color: {{ country_bg_color }};
      color: {{ country_text_color }};
      border: 2px solid {{ country_border_color }};
      border-radius: 25px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    #global-reach-{{ section.id }} .country-tag:hover {
      background-color: {{ country_bg_hover }};
      color: {{ country_text_hover }};
      border-color: {{ country_border_hover }};
      transform: translateY(-2px);
    }

    #global-reach-{{ section.id }} .world-map-container {
      {% if map_bg_color != blank %}
        background-color: {{ map_bg_color }};
      {% endif %}
      border-radius: 10px;
      padding: 20px;
      height: 400px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #global-reach-{{ section.id }} .world-map {
      width: 100%;
      height: auto;
      max-width: 700px;
      display: flex;
      justify-content: center;
    }

    #global-reach-{{ section.id }} .world-map .country {
      fill: {{ map_default_color }};
      stroke: #fff;
      stroke-width: 0.5;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    #global-reach-{{ section.id }} .world-map .country.background {
      fill: {{ map_default_color }};
      cursor: default;
    }

    #global-reach-{{ section.id }} .world-map .country.highlighted {
      fill: {{ map_highlight_color }};
    }

    #global-reach-{{ section.id }} .world-map .country.hover-active {
      fill: {{ map_hover_color }};
      stroke-width: 1;
      filter: brightness(1.1);
      transform: scale(1.02);
      transform-origin: center;
    }

    #global-reach-{{ section.id }} .global-reach-row {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    /* Enhanced hover effects for the detailed map */
    #global-reach-{{ section.id }} .world-map .country:hover {
      stroke-width: 1.5;
      filter: brightness(1.05);
    }

    /* Tooltip styling */
    #global-reach-{{ section.id }} .map-tooltip {
      position: absolute;
      background: rgba(0, 0, 0, 0.8);
      color: white;
      padding: 6px 12px;
      border-radius: 4px;
      font-size: 12px;
      pointer-events: none;
      transform: translate(-50%, -100%);
      margin-top: -8px;
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: 1000;
    }

    #global-reach-{{ section.id }} .map-tooltip.show {
      opacity: 1;
    }
    #global-reach-{{ section.id }} .world-map.gif-map img {
    display: block;
    max-width: 85% !important;
    height: auto;
  }


    /* Tablet Responsive (768px - 1199px) */
    @media (max-width: 1199px) and (min-width: 768px) {
      #global-reach-{{ section.id }} {
        margin-top: var(--mg-top-tablet);
        margin-bottom: var(--mg-bottom-tablet);
      }

      #global-reach-{{ section.id }} .global-reach-content {
        flex: 0 0 {{ content_width_tablet }}%;
        max-width: {{ content_width_tablet }}%;
      }

      #global-reach-{{ section.id }} .global-reach-map {
        flex: 0 0 {{ map_width_tablet }}%;
        max-width: {{ map_width_tablet }}%;
      }
    }

    /* Mobile Responsive (767px and below) */
    @media (max-width: 767px) {
      #global-reach-{{ section.id }} {
        margin-top: var(--mg-top-mobile);
        margin-bottom: var(--mg-bottom-mobile);
      }

      #global-reach-{{ section.id }} .global-reach-wrapper {
        padding: {{ mobile_padding_top }}px {{ mobile_padding_right }}px {{ mobile_padding_bottom }}px {{ mobile_padding_left }}px;
      }

      #global-reach-{{ section.id }} .section-title {
        font-size: {{ title_font_size_mobile }}px;
      }

      #global-reach-{{ section.id }} .section-description {
        font-size: {{ desc_font_size_mobile }}px;
      }

      #global-reach-{{ section.id }} .global-reach-row {
        flex-direction: column;
        gap: 30px;
      }

      #global-reach-{{ section.id }} .global-reach-content,
      #global-reach-{{ section.id }} .global-reach-map {
        flex: 0 0 100%;
        max-width: 100%;
      }

      #global-reach-{{ section.id }} .world-map-container {
        height: 300px;
        padding: 15px;
      }

      #global-reach-{{ section.id }} .country-tag {
        padding: 6px 12px;
        font-size: 13px;
        margin: 3px 6px 3px 0;
      }
    }

    /* Small Mobile (480px and below) */
    @media (max-width: 480px) {
      #global-reach-{{ section.id }} .global-reach-wrapper {
        padding: {{ mobile_padding_top | divided_by: 1.5 | round }}px {{ mobile_padding_right | divided_by: 1.5 | round }}px {{ mobile_padding_bottom | divided_by: 1.5 | round }}px {{ mobile_padding_left | divided_by: 1.5 | round }}px;
      }

      #global-reach-{{ section.id }} .world-map-container {
        height: 250px;
        padding: 10px;
      }

      #global-reach-{{ section.id }} .section-title {
        font-size: {{ title_font_size_mobile | minus: 4 }}px;
      }

      #global-reach-{{ section.id }} .country-tag {
        padding: 5px 10px;
        font-size: 12px;
        margin: 2px 4px 2px 0;
      }
    }
</style>

<div
  class="halo-block global-reach{% if enable_animation %} scroll-trigger animate--{{ animation_type }}{% endif %}"
  id="global-reach-{{ section.id }}"
  style="--mg-top-desktop: {{ mg_top_desktop }}px; --mg-top-tablet: {{ mg_top_tablet }}px; --mg-top-mobile: {{ mg_top_mobile }}px; --mg-bottom-desktop: {{ mg_bottom_desktop }}px; --mg-bottom-tablet: {{ mg_bottom_tablet }}px; --mg-bottom-mobile: {{ mg_bottom_mobile }}px;"
>
  <div class="{% if container == '1170' %}container-1170{% elsif container == '1470' %}container-1470{% elsif container == '1570' %}container-1570{% elsif container == '1770' %}container-1770{% elsif container == '1920' %}container-1920{% elsif container == 'fullwidth' %}container-full{% else %}container{% endif %}">
    <div class="global-reach-wrapper">
      <div class="global-reach-row{% if layout_direction == 'map-first' %} flex-row-reverse{% endif %}">
        <div class="global-reach-content text-{{ content_alignment }}">
          {%- if section_title != blank -%}
            <h2
              class="section-title{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
              {% if enable_animation %}
                style="--animation-order: 1;"
              {% endif %}
            >
              {{ section_title }}
            </h2>
          {%- endif -%}

          {%- if section_description != blank -%}
            <p
              class="section-description{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
              {% if enable_animation %}
                style="--animation-order: 2;"
              {% endif %}
            >
              {{ section_description }}
            </p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div
              class="countries-list{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
              {% if enable_animation %}
                style="--animation-order: 3;"
              {% endif %}
            >
              {%- for block in section.blocks -%}
                {%- if block.type == 'country' -%}
                  <span
                    class="country-tag"
                    data-country="{{ block.settings.country_code | default: block.settings.country_name | handle }}"
                    data-country-name="{{ block.settings.country_name }}"
                    {% if block.settings.country_link != blank %}
                      onclick="window.open('{{ block.settings.country_link }}', '{{ block.settings.link_target | default: '_self' }}')"
                    {% endif %}
                  >
                    {{ block.settings.country_name }}
                  </span>
                {%- elsif block.type == 'more_button' -%}
                  <a
                    class="country-tag"
                    {% if block.settings.more_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.more_link }}"
                    {% endif %}
                    {% if block.settings.link_target != '_self' %}
                      target="{{ block.settings.link_target }}"
                    {% endif %}
                  >
                    {{ block.settings.button_text | default: '30+ more' }}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div
          class="global-reach-map{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
          {% if enable_animation %}
            style="--animation-order: 4;"
          {% endif %}
        >
          <div class="world-map-container">
            {%- if use_custom_map and custom_map_svg != blank -%}
              <div class="world-map custom-map">
                {{ custom_map_svg }}
              </div>
            {%- elsif section.settings.map_gif_image != blank -%}
              <div class="world-map gif-map">
                <img
                  src="{{ section.settings.map_gif_image | image_url }}"
                  alt="Global Reach Map"
                  loading="lazy"
                  style="max-width: 100%; height: auto;"
                >
              </div>
            {%- else -%}
              <!-- Default SVG map -->
              <svg class="world-map detailed-map" ...>
                <!-- existing SVG content -->
              </svg>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const section = document.getElementById('global-reach-{{ section.id }}');
  if (!section) return;
  
  const countryTags = section.querySelectorAll('.country-tag[data-country]');
  const mapCountries = section.querySelectorAll('.world-map .country:not(.background)');
  const tooltip = document.createElement('div');
  
  // Create tooltip
  tooltip.className = 'map-tooltip';
  tooltip.id = 'map-tooltip-{{ section.id }}';
  section.appendChild(tooltip);
  
  // Initialize highlighted countries
  countryTags.forEach(tag => {
    const countryCode = tag.dataset.country;
    const mapCountry = section.querySelector(`.world-map .country[data-country="${countryCode}"]`);
    if (mapCountry) {
      mapCountry.classList.add('highlighted');
    }
  });
  
  // Country tag hover interactions (affects map)
  countryTags.forEach(tag => {
    const countryCode = tag.dataset.country;
    const countryName = tag.dataset.countryName || tag.textContent.trim();
    const mapCountry = section.querySelector(`.world-map .country[data-country="${countryCode}"]`);
    
    if (mapCountry) {
      // Tag hover affects map
      tag.addEventListener('mouseenter', () => {
        mapCountry.classList.add('hover-active');
      });
      
      tag.addEventListener('mouseleave', () => {
        mapCountry.classList.remove('hover-active');
      });
    }
  });
  
  // Map hover interactions (shows tooltip)
  mapCountries.forEach(country => {
    const countryCode = country.dataset.country;
    const matchingTag = section.querySelector(`.country-tag[data-country="${countryCode}"]`);
    
    if (matchingTag) {
      const countryName = matchingTag.dataset.countryName || matchingTag.textContent.trim();
      
      country.addEventListener('mouseenter', (e) => {
        // Show tooltip
        tooltip.textContent = countryName;
        tooltip.classList.add('show');
        
        // Highlight corresponding tag
        matchingTag.style.transform = 'translateY(-2px)';
        matchingTag.style.backgroundColor = '{{ country_bg_hover }}';
        matchingTag.style.color = '{{ country_text_hover }}';
      });
      
      country.addEventListener('mousemove', (e) => {
        // Update tooltip position
        const rect = section.getBoundingClientRect();
        tooltip.style.left = (e.clientX - rect.left) + 'px';
        tooltip.style.top = (e.clientY - rect.top) + 'px';
      });
      
      country.addEventListener('mouseleave', () => {
        // Hide tooltip
        tooltip.classList.remove('show');
        
        // Reset tag styling
        matchingTag.style.transform = '';
        matchingTag.style.backgroundColor = '';
        matchingTag.style.color = '';
      });
      
      // Click to open link if tag has one
      country.addEventListener('click', () => {
        if (matchingTag.onclick) {
          matchingTag.onclick();
        }
      });
    }
  });
  
  // Enhanced visual feedback
  mapCountries.forEach(country => {
    country.addEventListener('mouseenter', () => {
      country.style.cursor = 'pointer';
    });
  });
});
</script>

