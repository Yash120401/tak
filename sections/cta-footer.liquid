      height: auto;
    }

    .section-{{ section.id }} .cta-background-image img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    .section-{{ section.id }} .cta-title {
      font-size: 48px;
      font-weight: 700;
      line-height: 1.2;
      margin: 0 0 24px 0;
      color: {{ section.settings.cta_title_color | default: '#ffffff' }};
      letter-spacing: -0.02em;
    }

    .section-{{ section.id }} .cta-title .highlight {
      color: {{ section.settings.cta_highlight_color | default: '#FFC107' }};
    }

    .section-{{ section.id }} .cta-description {
      font-size: 18px;
      line-height: 1.6;
      margin: 0 0 32px 0;
      color: {{ section.settings.cta_text_color | default: '#ffffff' }};
      opacity: 0.9;
    }

    /* CTA Button Wrapper - Updated to handle multiple buttons */
    .section-{{ section.id }} .cta-button-wrapper {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      align-items: center;
    }

    .section-{{ section.id }} .cta-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: transparent;
      border: 2px solid {{ section.settings.cta_button_border_color | default: '#ffffff' }};
      color: {{ section.settings.cta_button_text_color | default: '#ffffff' }};
      padding: 16px 32px;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      transition: all 0.3s ease;
      border-radius: 4px;
    }

    .section-{{ section.id }} .cta-button:hover {
      background: {{ section.settings.cta_button_hover_bg | default: '#ffffff' }};
      color: {{ section.settings.cta_button_hover_text | default: '#4CAF50' }};
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .section-{{ section.id }} .cta-button svg {
      width: 19px;
      height: 20px;
      transition: transform 0.3s ease;
    }

    .section-{{ section.id }} .cta-button:hover svg {
      transform: translateX(4px);
    }

    /* WhatsApp Button Styles */
    .section-{{ section.id }} .whatsapp-button {
      background: {{ section.settings.whatsapp_button_bg | default: '#000000' }};
      border: 2px solid {{ section.settings.whatsapp_button_border | default: '#000000' }};
      color: {{ section.settings.whatsapp_button_text_color | default: '#ffffff' }};
    }

    .section-{{ section.id }} .whatsapp-button:hover {
      background: {{ section.settings.whatsapp_button_hover_bg | default: '#333333' }};
      color: {{ section.settings.whatsapp_button_hover_text | default: '#ffffff' }};
      border-color: {{ section.settings.whatsapp_button_hover_border | default: '#333333' }};
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    }

    .section-{{ section.id }} .whatsapp-button svg {
      width: 20px;
      height: 20px;
      transition: transform 0.3s ease;
    }

    .section-{{ section.id }} .whatsapp-button:hover svg {
      transform: translateX(4px);
    }

    /* Footer Section Styles */
    .section-{{ section.id }} .footer-section {
      background-color: {{ section.settings.footer_bg_color | default: '#f5f5f5' }};
      color: {{ section.settings.footer_text_color | default: '#333333' }};
      padding: 60px 0 0 0;
    }

    .section-{{ section.id }} .footer-container {
      {% if container == 'container' %}
        max-width: 1200px;
      {% elsif container == '1170' %}
        max-width: 1170px;
      {% elsif container == '1470' %}
        max-width: 1470px;
      {% elsif container == '1570' %}
        max-width: 1570px;
      {% elsif container == '1770' %}
        max-width: 1770px;
      {% elsif container == '1920' %}
        max-width: 1920px;
      {% elsif container == 'fullwidth' %}
        max-width: 100%;
      {% endif %}
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-{{ section.id }} .footer-content {
      display: flex;
      flex-direction: column;
      gap: 48px;
      padding-bottom: 40px;
    }

    .section-{{ section.id }} .footer-logo {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
    }

    .section-{{ section.id }} .footer-logo h3 {
      max-width: 150px;
      height: auto;
      margin: 0;
    }

    .section-{{ section.id }} .footer-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 48px;
    }

    .section-{{ section.id }} .footer-column-title {
      font-size: 20px;
      font-weight: 600;
      margin: 0 0 24px 0;
      color: {{ section.settings.footer_heading_color | default: '#2c3e50' }};
    }

    .section-{{ section.id }} .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .section-{{ section.id }} .footer-links a {
      color: {{ section.settings.footer_link_color | default: '#666666' }};
      text-decoration: none;
      font-size: 16px;
      transition: color 0.3s ease;
    }

    .section-{{ section.id }} .footer-links a:hover {
      color: {{ section.settings.footer_link_hover_color | default: '#4CAF50' }};
    }

    .section-{{ section.id }} .footer-contact p {
      margin: 0 0 12px 0;
      font-size: 16px;
      line-height: 1.6;
    }

    .section-{{ section.id }} .footer-contact a {
      color: {{ section.settings.footer_link_color | default: '#666666' }};
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .section-{{ section.id }} .footer-contact a:hover {
      color: {{ section.settings.footer_link_hover_color | default: '#4CAF50' }};
    }

    /* Newsletter Styles */
    .section-{{ section.id }} .newsletter-input-wrapper {
      display: flex;
      gap: 0;
      margin-bottom: 24px;
    }

    .section-{{ section.id }} .newsletter-input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid {{ section.settings.newsletter_border_color | default: '#ddd' }};
      border-radius: 4px 0 0 4px;
      font-size: 14px;
      outline: none;
      background: {{ section.settings.newsletter_input_bg | default: '#ffffff' }};
    }

    .section-{{ section.id }} .newsletter-input:focus {
      border-color: {{ section.settings.footer_link_hover_color | default: '#4CAF50' }};
    }

    .section-{{ section.id }} .newsletter-button {
      background: {{ section.settings.newsletter_button_bg | default: '#4CAF50' }};
      color: {{ section.settings.newsletter_button_text_color | default: '#ffffff' }};
      border: none;
      padding: 12px 20px;
      border-radius: 0 4px 4px 0;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s ease;
      font-size: 14px;
    }

    .section-{{ section.id }} .newsletter-button:hover {
      background: {{ section.settings.newsletter_button_hover | default: '#45a049' }};
    }

    .section-{{ section.id }} .social-title {
      font-size: 18px;
      font-weight: 600;
      color: {{ section.settings.footer_heading_color | default: '#2c3e50' }};
    }

    .section-{{ section.id }} .social-links {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .section-{{ section.id }} .social-link {
      width: 40px;
      height: 40px;
      color: {{ section.settings.social_text_color | default: '#ffffff' }};
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      border-radius: 50%;
      transition: all 0.3s ease;
      font-size: 12px;
      position: relative;
      overflow: hidden;
    }

    .section-{{ section.id }} .social-link:hover {
      background: {{ section.settings.social_hover_bg | default: '#45a049' }};
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(76, 175, 80, 0.3);
    }

    .section-{{ section.id }} .social-link img {
      width: 40px;
      height: 40px;
      object-fit: contain;
    }

    .section-{{ section.id }} .social-link svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    .section-{{ section.id }} .social-text {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      line-height: 1;
    }

    /* Footer Bottom */
    .section-{{ section.id }} .footer-bottom {
      border-top: 1px solid {{ section.settings.footer_border_color | default: '#ddd' }};
      padding: 24px 0;
    }

    .section-{{ section.id }} .footer-bottom-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
    }

    .section-{{ section.id }} .copyright {
      margin: 0;
      font-size: 14px;
      color: {{ section.settings.footer_text_color | default: '#666666' }};
    }

    .section-{{ section.id }} .footer-bottom-links {
      display: flex;
      gap: 24px;
    }

    .section-{{ section.id }} .footer-bottom-links a {
      color: {{ section.settings.footer_link_color | default: '#666666' }};
      text-decoration: none;
      font-size: 14px;
      transition: color 0.3s ease;
    }

    .section-{{ section.id }} .footer-bottom-links a:hover {
      color: {{ section.settings.footer_link_hover_color | default: '#4CAF50' }};
    }

    /* Responsive Design */
    @media screen and (max-width: 1024px) {
      .section-{{ section.id }} {
        padding-top: {{ mg_top_tablet }}px;
        padding-bottom: {{ mg_bottom_tablet }}px;
      }

      .section-{{ section.id }} .cta-content {
        gap: 40px;
      }

      .section-{{ section.id }} .cta-title {
        font-size: 40px;
      }

      .section-{{ section.id }} .footer-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 32px;
      }

      .section-{{ section.id }} .footer-logo {
        align-items: center;
        text-align: center;
      }

      .section-{{ section.id }} .social-links {
        justify-content: center;
      }
    }

    @media screen and (max-width: 768px) {
      .section-{{ section.id }} {
        padding-top: {{ mg_top_mobile }}px;
        padding-bottom: {{ mg_bottom_mobile }}px;
      }

      .section-{{ section.id }} .cta-section {
        padding: 30px 0;
      }

      .section-{{ section.id }} .cta-title {
        font-size: 32px;
      }

      .section-{{ section.id }} .cta-description {
        font-size: 16px;
      }

      .section-{{ section.id }} .cta-button-wrapper {
        flex-direction: column;
        gap: 12px;
        width: 100%;
      }

      .section-{{ section.id }} .cta-button,
      .section-{{ section.id }} .whatsapp-button {
        width: 100%;
        justify-content: center;
        text-align: center;
      }

      .section-{{ section.id }} .footer-grid {
        gap: 32px;
      }

      .section-{{ section.id }} .footer-logo {
        align-items: center;
        text-align: center;
      }

      .section-{{ section.id }} .social-links {
        justify-content: center;
      }

      .section-{{ section.id }} .footer-bottom-content {
        flex-direction: column;
        gap: 16px;
        text-align: center;
      }

      .section-{{ section.id }} .footer-bottom-links {
        justify-content: center;
      }
    }

    @media screen and (max-width: 480px) {
      .section-{{ section.id }} .cta-container,
      .section-{{ section.id }} .footer-container {
        padding: 0 5px;
      }

      .section-{{ section.id }} .cta-title {
        font-size: 28px;
      }

      .section-{{ section.id }} .cta-button,
      .section-{{ section.id }} .whatsapp-button {
        padding: 14px 24px;
        font-size: 14px;
      }

      .section-{{ section.id }} .cta-button-wrapper {
        gap: 10px;
      }

      .section-{{ section.id }} .newsletter-input-wrapper {
        flex-direction: column;
        gap: 12px;
      }

      .section-{{ section.id }} .newsletter-input,
      .section-{{ section.id }} .newsletter-button {
        border-radius: 4px;
        width: 100%;
      }

      .section-{{ section.id }} .social-link {
        width: 40px;
        height: 40px;
      }
    }
</style>

