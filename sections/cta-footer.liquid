                        {%- endcase -%}
                      {%- else -%}
                        <!-- Final fallback to text -->
                        <span class="social-text">
                          {{- block.settings.platform_select | default: 'SM' | truncate: 2, '' | upcase -}}
                        </span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        <!-- Footer Links Grid -->
        <div class="footer-grid">
          <!-- Quick Links -->
          <div class="footer-column">
            <h4 class="footer-column-title">
              {{ section.settings.quick_links_title | default: 'Quick Links' }}
            </h4>
            <ul class="footer-links">
              {%- if section.settings.quick_links_menu != blank -%}
                {%- for link in linklists[section.settings.quick_links_menu].links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <!-- Fallback links if no menu is selected -->
                <li><a href="/">Home</a></li>
                <li><a href="/pages/about">About Us</a></li>
                <li><a href="/pages/services">Services</a></li>
                <li><a href="/collections/all">Products</a></li>
                <li><a href="/pages/contact">Contact Us</a></li>
              {%- endif -%}
            </ul>
          </div>

          <!-- TAK Products -->
          <div class="footer-column">
            <h4 class="footer-column-title">
              {{ section.settings.products_title | default: 'TAK Products' }}
            </h4>
            <ul class="footer-links">
              {%- if section.settings.products_menu != blank -%}
                {%- for link in linklists[section.settings.products_menu].links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                <!-- Fallback links if no menu is selected -->
                <li><a href="/collections/dry-apricots">Dry Apricots</a></li>
                <li><a href="/collections/raisins">Raisins</a></li>
                <li><a href="/collections/mulberries">Mulberries</a></li>
                <li><a href="/collections/nuts">Nuts</a></li>
                <li><a href="/collections/others">Others</a></li>
              {%- endif -%}
            </ul>
          </div>

          <!-- Contact Us -->
          <div class="footer-column">
            <h4 class="footer-column-title">
              {{ section.settings.contact_title | default: 'Contact us' }}
            </h4>
            <div class="footer-contact">
              {%- if section.settings.contact_email != blank -%}
                <p>
                  <strong>Mail us :</strong>
                  <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
                </p>
              {%- endif -%}

              {%- if section.settings.contact_phone != blank -%}
                <p>
                  <strong>Call us :</strong>
                  <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' }}">
                    {{- section.settings.contact_phone -}}
                  </a>
                </p>
              {%- endif -%}

              {%- if section.settings.whatsapp_number != blank -%}
                <p>
                  <strong>WhatsApp :</strong>
                  <a
                    href="https://wa.me/{{ section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}{% if section.settings.whatsapp_message != blank %}?text={{ section.settings.whatsapp_message | url_param_escape }}{% endif %}"
                    target="_blank"
                    rel="noopener"
                  >
                    {{- section.settings.whatsapp_number -}}
                  </a>
                </p>
              {%- endif -%}

              {%- if section.settings.contact_address != blank -%}
                <p><strong>Address :</strong> {{ section.settings.contact_address }}</p>
              {%- endif -%}
            </div>
          </div>

          <!-- Newsletter -->
          <div class="footer-column">
            <h4 class="footer-column-title">
              {{ section.settings.newsletter_title | default: 'Subscribe Newsletter' }}
            </h4>
            <div class="newsletter-form">
              {%- form 'customer', class: 'newsletter-form-element' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-input-wrapper">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter email' }}"
                    required
                    class="newsletter-input"
                  >
                  <button type="submit" class="newsletter-button">
                    {{ section.settings.newsletter_button_text | default: 'Subscribe' }}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <div class="footer-bottom-content">
          <p class="copyright">
            {{ section.settings.copyright_text | default: 'TAK © 2025. All Rights Reserved.' }}
          </p>
          <div class="footer-bottom-links">
            {%- for block in section.blocks -%}
              {%- if block.type == 'footer_bottom_link' -%}
                <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </footer>
</section>

