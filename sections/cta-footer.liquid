{%- liquid
  assign container = section.settings.container
  assign section_bg_color = section.settings.background_color
  assign mg_top_desktop = section.settings.padding_top
  assign mg_top_tablet = section.settings.padding_top_tablet
  assign mg_top_mobile = section.settings.padding_top_mobile
  assign mg_bottom_desktop = section.settings.padding_bottom
  assign mg_bottom_tablet = section.settings.padding_bottom_tablet
  assign mg_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<!-- CTA Footer Section -->
<section class="cta-footer-section section-{{ section.id }}" id="section-{{ section.id }}">
  <!-- CTA Section -->
  <div class="cta-section">
    <div class="cta-container">
      <div class="cta-content">
        <div class="cta-text-content">
          <h2 class="cta-title">
            {%- if section.settings.cta_title != blank -%}
              {{ section.settings.cta_title }}
            {%- else -%}
              Ready to Work With a Trusted <span class="highlight">Agricultural Partner?</span>
            {%- endif -%}
          </h2>

          <p class="cta-description">
            {%- if section.settings.cta_description != blank -%}
              {{ section.settings.cta_description }}
            {%- else -%}
              At TAK, we combine advanced infrastructure, strong farmer partnerships, and a client-first approach to
              deliver premium agricultural products to global markets.
            {%- endif -%}
          </p>

          <div class="cta-button-wrapper">
            {%- if section.settings.show_whatsapp_button -%}
              <a
                href="https://wa.me/{{ section.settings.whatsapp_button_number | replace: '+', '' | replace: ' ', '' }}{% if section.settings.whatsapp_button_message != blank %}?text={{ section.settings.whatsapp_button_message | url_param_escape }}{% endif %}"
                target="_blank"
                rel="noopener"
                class="cta-button whatsapp-button"
              >
                {{ section.settings.whatsapp_button_text | default: 'Chat on WhatsApp' }}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.525 3.687" fill="currentColor"/>
                </svg>
              </a>
            {%- endif -%}

            <a href="{{ section.settings.cta_button_link | default: '/contact' }}" class="cta-button">
              {{ section.settings.cta_button_text | default: 'Get in Touch' }}
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="20" viewBox="0 0 19 20" fill="none">
                <path d="M9.49997 0.580078C5.11613 0.580078 1.20509 3.73104 0.288054 8.02176C-0.170106 10.1657 0.138534 12.4454 1.16069 14.3854C2.14445 16.2523 3.75725 17.7612 5.68685 18.6163C7.69397 19.506 9.99821 19.661 12.1078 19.0543C14.143 18.4692 15.9476 17.185 17.1761 15.461C19.7449 11.857 19.4014 6.7944 16.3793 3.56496C14.6081 1.67232 12.0925 0.580078 9.49997 0.580078ZM14.0189 10.5034L11.4509 13.1333C10.8008 13.7993 9.77309 12.7903 10.4206 12.1274L11.7164 10.8005H5.57573C5.13965 10.8005 4.77581 10.4364 4.77581 10.0006C4.77581 9.56472 5.13989 9.20064 5.57573 9.20064H11.6857L10.3642 7.87944C9.70757 7.2228 10.7257 6.20448 11.3823 6.86112L14.0129 9.49152C14.1469 9.62542 14.2227 9.80677 14.2238 9.99621C14.225 10.1856 14.1513 10.3679 14.0189 10.5034Z" fill="currentColor"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Section -->
  <footer class="footer-section">
    <div class="footer-container">
      <div class="footer-content">
        <!-- Logo -->
        <div class="footer-logo">
          {%- if section.settings.footer_logo != blank -%}
            <img
              src="{{ section.settings.footer_logo | image_url: width: 150 }}"
              alt="{{ shop.name }}"
              width="150"
              height="60px"
              loading="lazy"
            >
          {%- else -%}
            <h3>{{ shop.name }}</h3>
          {%- endif -%}

          <!-- Social Media -->
          {%- if section.settings.show_social_media -%}
            <div class="social-media">
              <h5 class="social-title">{{ section.settings.social_title | default: 'Follow Us' }}</h5>
              <div class="social-links">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'social_link' -%}
                    <a
                      href="{{ block.settings.url }}"
                      target="_blank"
                      rel="noopener"
                      class="social-link"
                      title="{{ block.settings.platform_select }}"
                      aria-label="Follow us on {{ block.settings.platform_select }}"
                    >
                      {%- if block.settings.custom_icon != blank -%}
                        <!-- Custom uploaded icon takes priority -->
                        <img
                          src="{{ block.settings.custom_icon | image_url: width: 24 }}"
                          alt="{{ block.settings.platform_select }} Icon"
                          width="24"
                          height="24"
                          loading="lazy"
                        >
                      {%- elsif block.settings.platform_select != blank -%}
                        <!-- Predefined platform icons -->
