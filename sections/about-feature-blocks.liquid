{% schema %}
{
  "name": "About Feature Blocks",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "select",
      "id": "heading_font_family",
      "label": "Heading Font Family",
      "options": [
        { "value": "Kumbh Sans", "label": "Kumbh Sans" },
        { "value": "sans-serif", "label": "Sans Serif" }
      ],
      "default": "Kumbh Sans"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size (px)",
      "min": 18,
      "max": 60,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height (px)",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "SemiBold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description Line Height (px)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "SemiBold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    }
  ],
  "blocks": [
    {
      "type": "feature_block",
      "name": "Feature Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image Position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "image_col_width",
          "label": "Image Column Width (%)",
          "min": 30,
          "max": 70,
          "step": 5,
          "default": 50
        },
        {
          "type": "range",
          "id": "column_gap",
          "label": "Column Gap (px)",
          "min": 0,
          "max": 100,
          "step": 4,
          "default": 24
        },
        {
          "type": "range",
          "id": "row_padding",
          "label": "Row Spacing (Top & Bottom px)",
          "min": 0,
          "max": 100,
          "step": 4,
          "default": 40
        },
        {
          "type": "range",
          "id": "image_border_radius",
          "label": "Image Border Radius (px)",
          "min": 0,
          "max": 50,
          "step": 2,
          "default": 12
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our Mission"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "This is a short paragraph describing your mission, story, or purpose."
        },
        {
          "type": "textarea",
          "id": "list_items",
          "label": "Bullet Points (one per line)",
          "default": "Point One\nPoint Two\nPoint Three"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#f4fdf6"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Feature Blocks",
      "category": "Custom Sections",
      "blocks": [
        { "type": "feature_block" }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;600;700&display=swap');

  .custom-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 20px;
    border: 1px solid #00A000;
    border-radius: 6px;
    background: #fff;
    color: #00A000;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .custom-button::after {
    content: '→';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #00A000;
    color: white;
    border-radius: 50%;
    width: 28px;
    height: 28px;
    margin-left: 10px;
    font-size: 16px;
    transition: background 0.3s;
  }

  .custom-button::before {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 20px;
    height: 20px;
    background: #00A000;
    clip-path: polygon(100% 100%, 0 100%, 100% 0);
  }
{% endstylesheet %}

<section
  class="container-custom container"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% for block in section.blocks %}
    <div style="background-color: {{ block.settings.background_color }}; padding-top: {{ block.settings.row_padding }}px; padding-bottom: {{ block.settings.row_padding }}px;">
      <div class="container">
        <div
          class="row align-items-center {% if block.settings.image_position == 'right' %}flex-row-reverse{% endif %}"
          style="gap: {{ block.settings.column_gap }}px;"
        >
          <!-- Image Column -->
          <div
            class="col-md-6"
            style="flex: 0 0 {{ block.settings.image_col_width }}%; max-width: {{ block.settings.image_col_width }}%;"
          >
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.heading }}"
                class="img-fluid"
                style="border-radius: {{ block.settings.image_border_radius }}px;"
              >
            {% endif %}
          </div>

          <!-- Text Column -->
          <div
            class="col-md-6"
            style="flex: 0 0 calc(100% - {{ block.settings.image_col_width }}%); max-width: calc(100% - {{ block.settings.image_col_width }}%);"
          >
            <h2
              style="
                font-family: '{{ section.settings.heading_font_family }}', sans-serif;
                font-size: {{ section.settings.heading_font_size }}px;
                line-height: {{ section.settings.heading_line_height }}px;
                font-weight: {{ section.settings.heading_font_weight }};
                margin-bottom: 16px;
              "
            >
              {{ block.settings.heading }}
            </h2>

            <p
              style="
                font-family: '{{ section.settings.heading_font_family }}', sans-serif;
                font-size: {{ section.settings.description_font_size }}px;
                line-height: {{ section.settings.description_line_height }}px;
                font-weight: 400;
                margin-bottom: 24px;
              "
            >
              {{ block.settings.text }}
            </p>

            {% if block.settings.list_items != blank %}
              <ul class="mb-4">
                {% assign items = block.settings.list_items | split: '\n' %}
                {% for item in items %}
                  <li class="mb-2"><span class="text-success me-2">✔</span>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="custom-button"
                style="font-weight: {{ section.settings.button_font_weight }}"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</section>
