{%- liquid
  assign padding_top = section.settings.mg_top_desktop | append: 'px'
  assign padding_bottom = section.settings.mg_bottom_desktop | append: 'px'
  assign padding_top_tablet = section.settings.mg_top_tablet | append: 'px'
  assign padding_bottom_tablet = section.settings.mg_bottom_tablet | append: 'px'
  assign padding_top_mobile = section.settings.mg_top_mobile | append: 'px'
  assign padding_bottom_mobile = section.settings.mg_bottom_mobile | append: 'px'
  assign show_breadcrumb = section.settings.show_breadcrumb
  assign breadcrumb_alignment = section.settings.breadcrumb_alignment
  assign breadcrumb_bg = section.settings.breadcrumb_bg
  assign breadcrumb_gradient = section.settings.breadcrumb_gradient
  assign breadcrumb_bg_mb = section.settings.breadcrumb_bg_mb
  assign breadcrumb_gradient_mb = section.settings.breadcrumb_gradient_mb
  assign show_page_title = section.settings.show_page_title
  assign page_title_alignment = section.settings.page_title_alignment
  assign container = section.settings.container
  assign padding_full_width = section.settings.padding_full_width
  assign contact_form_title = section.settings.contact_form_title
  assign contact_form_text = section.settings.contact_form_text
  assign show_contact_info = section.settings.show_contact_info
  if show_contact_info
    assign has_contact_info = false
    assign contact_info_title = section.settings.contact_info_title
    assign contact_info_text = section.settings.contact_info_text
    assign contact_info_address = section.settings.contact_info_address
    assign contact_info_content_1 = section.settings.contact_info_content_1
    assign contact_info_phone = section.settings.contact_info_phone
    assign contact_info_email = section.settings.contact_info_email
    assign enable_border_top = section.settings.enable_border_top
    if contact_info_title != blank or contact_info_text != blank or contact_info_address != blank or contact_info_content_1 != blank or contact_info_phone != blank or contact_info_email != blank
      assign has_contact_info = true
    endif
  endif
-%}

<div
  data-section-id="{{ section.id }}"
  data-section-type="contact"
  id="ContactSection-{{ section.id }}"
  data-section="{{ section.id }}"
>
  <div class="contact-container {% if container == '1170' %}container-1170{% elsif container == '1770' %}container-1770{% elsif container == 'fullwidth'%}container-full{% else %}container{% endif %}">
    {%- if show_breadcrumb -%}
      {% render 'breadcrumb', alignment: breadcrumb_alignment %}
    {%- endif -%}

    {%- if show_page_title -%}
      <h1 class="page-header text-{{ page_title_alignment }}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        {{ page.title | escape }}
      </h1>
    {%- endif -%}

    <div class="page-content contact-content{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
      {%- if contact_form_title != blank -%}
        <h1 class="contact-form-title{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
          {{ contact_form_title }}
        </h1>
      {%- endif %}

      {%- if contact_form_text != blank -%}
        <p class="subtitle{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
          {{ contact_form_text }}
        </p>
      {%- endif %}
      <div class="contact-wrapper">
        <div class="form-section">
          {%- form 'contact', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-message form-message--success">
                <p>{{ 'templates.contact.form.post_success' | t }}</p>
              </div>
            {%- endif -%}

            {{ form.errors | default_errors }}

            <div class="form-group">
              <label for="ContactForm-name">Name</label>
              <input
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                autocomplete="name"
              >
            </div>

            <div class="form-group">
              <label for="ContactForm-phone">Phone Number</label>
              <input
                type="tel"
                id="ContactForm-phone"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                autocomplete="tel"
                pattern="[0-9\-]*"
              >
            </div>

            <div class="form-group">
              <label for="ContactForm-email">Email*</label>
              <input
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
              >
              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>

            <div class="form-group">
              <label for="ContactForm-body">Comment*</label>
              <textarea
                id="ContactForm-body"
                name="contact[{{ 'templates.contact.form.comment' | t }}]"
                rows="10"
              >{{- form.body -}}</textarea>
            </div>

            <button type="submit" class="submit-btn">Submit Contact ✓</button>
          {%- endform -%}
        </div>

        {%- if show_contact_info -%}
          {%- if has_contact_info -%}
            <div class="contact-section{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
              {%- if contact_info_title != blank -%}
                <h2 class="contact-info-title">
                  {{ contact_info_title }}
                </h2>
              {%- endif %}

              {%- if contact_info_text != blank -%}
                <p class="contact-intro">
                  {{ contact_info_text }}
                </p>
              {%- endif %}

              {%- if contact_info_content_1 != blank -%}
                <div class="contact-item">
                  <div class="contact-icon">
                    {%- if section.settings.office_hours_icon != blank -%}
                      <img
                        src="{{ section.settings.office_hours_icon | image_url: width: 24 }}"
                        alt="Office Hours"
                        width="24"
                        height="24"
                      >
                    {%- else -%}
                      🕐
                    {%- endif -%}
                  </div>
                  <div class="contact-content">
                    <h3>Office Hours</h3>
                    <p>{{ contact_info_content_1 | newline_to_br }}</p>
                  </div>
                </div>
              {%- endif -%}

              {%- if section.settings.contact_info_phone != blank -%}
                <div class="contact-item">
                  <div class="contact-icon">
                    {%- if section.settings.phone_icon != blank -%}
                      <img
                        src="{{ section.settings.phone_icon | image_url: width: 24 }}"
                        alt="Phone"
                        width="24"
                        height="24"
                      >
                    {%- else -%}
                      📞
                    {%- endif -%}
                  </div>
                  <div class="contact-content">
                    <h3>Phone</h3>
                    <p>{{ section.settings.contact_info_phone }}</p>
                  </div>
                </div>
              {%- endif -%}

              {%- if section.settings.contact_info_email != blank -%}
                <div class="contact-item">
                  <div class="contact-icon">
                    {%- if section.settings.email_icon != blank -%}
                      <img
                        src="{{ section.settings.email_icon | image_url: width: 24 }}"
                        alt="Email"
                        width="24"
                        height="24"
                      >
                    {%- else -%}
                      ✉️
                    {%- endif -%}
                  </div>
                  <div class="contact-content">
                    <h3>Email</h3>
                    <p>{{ section.settings.contact_info_email }}</p>
                  </div>
                </div>
              {%- endif -%}

              {%- if contact_info_address != blank -%}
                <div class="contact-item">
                  <div class="contact-icon">
                    {%- if section.settings.address_icon != blank -%}
                      <img
                        src="{{ section.settings.address_icon | image_url: width: 24 }}"
                        alt="Address"
                        width="24"
                        height="24"
                      >
                    {%- else -%}
                      📍
                    {%- endif -%}
                  </div>
                  <div class="contact-content">
                    <h3>Address</h3>
                    <p>{{ contact_info_address | newline_to_br }}</p>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style type="text/css" media="screen">
  #ContactSection-{{ section.id }} {
      padding-top: {{ padding_top }};
      padding-bottom: {{ padding_bottom }};
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background-color: #fff;
      color: #333;
  }

  /* Container Settings */
  #ContactSection-{{ section.id }} .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
  }

  #ContactSection-{{ section.id }} .container-1170 {
      max-width: 1170px;
      margin: 0 auto;
      padding: 0 20px;
  }

  #ContactSection-{{ section.id }} .container-1770 {
      max-width: 1770px;
      margin: 0 auto;
      padding: 0 20px;
  }

  #ContactSection-{{ section.id }} .container-full {
      width: 100%;
      margin: 0 auto;
  }

  /* Page Header */
  #ContactSection-{{ section.id }} .page-header {
      font-size: 36px;
      font-weight: 700;
      margin-bottom: 40px;
      color: #000;
  }

  #ContactSection-{{ section.id }} .text-left { text-align: left; }
  #ContactSection-{{ section.id }} .text-center { text-align: center; }
  #ContactSection-{{ section.id }} .text-right { text-align: right; }

  /* Main Container */
  #ContactSection-{{ section.id }} .contact-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 100px;
  }

  /* Form Section */
  #ContactSection-{{ section.id }} .contact-form-title {
      font-size: 40px;
    font-weight: 700;
    color: #000;
    margin-bottom: 15px;
    letter-spacing: 0;
  }

  #ContactSection-{{ section.id }} .subtitle {
      color: #666;
      font-size: 15px;
      line-height: 1.6;
      margin-bottom: 45px;
  }

  #ContactSection-{{ section.id }} .form-group {
      margin-bottom: 30px;
  }

  #ContactSection-{{ section.id }} .form-group label {
      display: block;
      font-size: 14px;
      color: #333;
      margin-bottom: 8px;
      font-weight: 400;
  }

  #ContactSection-{{ section.id }} .form-group input,
  #ContactSection-{{ section.id }} .form-group textarea {
      width: 100%;
      padding: 15px;
      border: 1px solid #e5e5e5;
      border-radius: 5px;
      font-size: 16px;
      background: #fff;
      font-family: inherit;
  }

  #ContactSection-{{ section.id }} .form-group input:focus,
  #ContactSection-{{ section.id }} .form-group textarea:focus {
      outline: none;
      border-color: #ccc;
  }

  #ContactSection-{{ section.id }} .form-group textarea {
      height: 120px;
      resize: vertical;
  }

  #ContactSection-{{ section.id }} .submit-btn {
      background: #28a745;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 25px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
  }

  #ContactSection-{{ section.id }} .submit-btn:hover {
      background: #218838;
  }

  /* Form Messages */
  #ContactSection-{{ section.id }} .form-message {
      margin-bottom: 20px;
      padding: 15px;
      border-radius: 4px;
  }

  #ContactSection-{{ section.id }} .form-message--success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
  }

  #ContactSection-{{ section.id }} .contact__field-error {
      color: #dc3545;
      font-size: 12px;
      margin-top: 5px;
      display: block;
  }

  #ContactSection-{{ section.id }} .visually-hidden {
      position: absolute !important;
      overflow: hidden;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      clip: rect(0 0 0 0);
      word-wrap: normal !important;
  }

  /* Contact Info Section */

  #ContactSection-{{ section.id }} .contact-info-title {
    font-size: 24px;
    font-weight: 700;
    color: #0E0F13;
    margin: 0;
    font-family: 'Kumbh Sans';
    letter-spacing: 0 !important;
  }

  #ContactSection-{{ section.id }} .contact-intro {
      color: #666;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 40px;
  }

  #ContactSection-{{ section.id }} .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 25px;
      {% if enable_border_top %}border-bottom: 1px dotted #009D03;{% endif %}
  }

  #ContactSection-{{ section.id }} .contact-item:last-child {
      border-bottom: none;
  }

  #ContactSection-{{ section.id }} .contact-icon {
      width: 45px;
      height: 45px;
      background: #FEC62D;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 18px;
  }

  #ContactSection-{{ section.id }} .contact-icon img {
      width: 36px;
      height: 36px;
      object-fit: contain;
  }

  #ContactSection-{{ section.id }} .contact-content h3 {
      font-size: 16px;
      font-weight: 600;
      color: #0E0F13;
      margin: 0;
  }

  #ContactSection-{{ section.id }} .contact-content p {
    font-size: 16px;
    color: #0E0F13;
    line-height: 1.5;
    font-weight: 400;
    font-family: 'Kumbh Sans';
    letter-spacing: 0;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
      #ContactSection-{{ section.id }} {
          padding-top: {{ padding_top_tablet }};
          padding-bottom: {{ padding_bottom_tablet }};
      }

      #ContactSection-{{ section.id }} .contact-wrapper {
          grid-template-columns: 1fr;
      }
      #ContactSection-{{ section.id }} .contact-wrapper {
          gap: 50px;
      }

      #ContactSection-{{ section.id }} .form-section {
          padding: 40px 25px;
      }

      #ContactSection-{{ section.id }} .contact-section {
          padding: 40px 25px;
      }

      {% if breadcrumb_gradient_mb != blank and breadcrumb_gradient_mb != 'rgba(0,0,0,0)' %}
      #ContactSection-{{ section.id }} .breadcrumb {
          background: {{ breadcrumb_gradient_mb }};
      }
      {% elsif breadcrumb_bg_mb != blank and breadcrumb_bg_mb != 'rgba(0,0,0,0)' %}
      #ContactSection-{{ section.id }} .breadcrumb {
          background: {{ breadcrumb_bg_mb }};
      }
      {% endif %}
  }

  @media (max-width: 768px) {
      #ContactSection-{{ section.id }} {
          padding-top: {{ padding_top_mobile }};
          padding-bottom: {{ padding_bottom_mobile }};
      }

      #ContactSection-{{ section.id }} .contact-form-title,
      #ContactSection-{{ section.id }} .contact-info-title {
          font-size: 28px;
      }

      #ContactSection-{{ section.id }} .form-section,
      #ContactSection-{{ section.id }} .contact-section {
          padding: 10px;
      }

      #ContactSection-{{ section.id }} .submit-btn {
          width: 100%;
          justify-content: center;
      }
      #ContactSection-{{ section.id }} .contact-wrapper {
          gap: 30px;
      }
  }

  @media (min-width: 1025px) {
      {% if container == 'fullwidth' %}
          #ContactSection-{{ section.id }} > .container-full {
              padding-left: {{ padding_full_width | append: 'px' }};
              padding-right: {{ padding_full_width | append: 'px' }};
          }
      {% endif %}

      {% if breadcrumb_gradient != blank and breadcrumb_gradient != 'rgba(0,0,0,0)' %}
      #ContactSection-{{ section.id }} .breadcrumb::after {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: {{ breadcrumb_gradient }};
          z-index: -1;
      }
      {% elsif breadcrumb_bg != blank and breadcrumb_bg != 'rgba(0,0,0,0)' %}
      #ContactSection-{{ section.id }} .breadcrumb::after {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: {{ breadcrumb_bg }};
          z-index: -1;
      }
      {% endif %}
  }
</style>

{% schema %}
{
    "name": "Custom Contact Form",
    "settings": [
        {
            "type": "paragraph",
            "content": "Professional contact form with two-column layout matching your design requirements."
        },
        {
            "type": "header",
            "content": "Container Settings"
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container Width",
            "default": "container",
            "options": [
                {
                    "value": "container",
                    "label": "Container"
                },
                {
                    "value": "1170",
                    "label": "1170px"
                },
                {
                    "value": "1770",
                    "label": "1770px"
                },
                {
                    "value": "fullwidth",
                    "label": "Full Width"
                }
            ]
        },
        {
            "type": "range",
            "id": "padding_full_width",
            "label": "Full Width Padding",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "checkbox",
            "id": "show_breadcrumb",
            "label": "Show Breadcrumb",
            "default": false
        },
        {
            "type": "select",
            "id": "breadcrumb_alignment",
            "label": "Breadcrumb Alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "color",
            "id": "breadcrumb_bg",
            "label": "Breadcrumb Background"
        },
        {
            "type": "color_background",
            "id": "breadcrumb_gradient",
            "label": "Breadcrumb Gradient"
        },
        {
            "type": "color",
            "id": "breadcrumb_bg_mb",
            "label": "Breadcrumb Background (Mobile)",
            "default": "#f6f6f6"
        },
        {
            "type": "color_background",
            "id": "breadcrumb_gradient_mb",
            "label": "Breadcrumb Gradient (Mobile)"
        },
        {
            "type": "checkbox",
            "id": "show_page_title",
            "label": "Show Page Title",
            "default": false
        },
        {
            "type": "select",
            "id": "page_title_alignment",
            "label": "Page Title Alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "center",
                    "label": "Center"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "left"
        },
        {
            "type": "header",
            "content": "Contact Form Settings"
        },
        {
            "type": "text",
            "id": "contact_form_title",
            "label": "Contact Form Title",
            "default": "Get in touch"
        },
        {
            "type": "textarea",
            "id": "contact_form_text",
            "label": "Contact Form Description",
            "default": "We'd love to hear from you! Whether you're a potential partner, buyer, or supplier, our team is ready to assist you with your agricultural needs."
        },
        {
            "type": "header",
            "content": "Contact Information Settings"
        },
        {
            "type": "checkbox",
            "id": "show_contact_info",
            "label": "Show Contact Information",
            "default": true
        },
        {
            "type": "text",
            "id": "contact_info_title",
            "label": "Contact Info Title",
            "default": "Contact Info"
        },
        {
            "type": "textarea",
            "id": "contact_info_text",
            "label": "Contact Info Description",
            "default": "We'd love to hear from you - please use the form to send us your message or ideas."
        },
        {
            "type": "textarea",
            "id": "contact_info_content_1",
            "label": "Office Hours",
            "default": "Sunday - Thursday: 9:00 AM - 5:00 PM\nFriday & Saturday: Closed"
        },
        {
            "type": "text",
            "id": "contact_info_phone",
            "label": "Phone Number",
            "default": "+91 9989775560"
        },
        {
            "type": "text",
            "id": "contact_info_email",
            "label": "Email Address",
            "default": "info@tak.af"
        },
        {
            "type": "textarea",
            "id": "contact_info_address",
            "label": "Address",
            "default": "Block A, No. 1996200, Shadam Industrial Park, district 6, Mazar i Sharif, Balkh, Afghanistan"
        },
        {
            "type": "checkbox",
            "id": "enable_border_top",
            "label": "Enable Border Between Contact Items",
            "default": true
        },
        {
            "type": "header",
            "content": "Contact Icons"
        },
        {
            "type": "image_picker",
