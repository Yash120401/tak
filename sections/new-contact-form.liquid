            "info": "Upload custom icon for office hours (36x36px recommended). Leave empty to use default emoji."
        },
        {
            "type": "image_picker",
            "id": "phone_icon",
            "label": "Phone Icon",
            "info": "Upload custom icon for phone (36x36px recommended). Leave empty to use default emoji."
        },
        {
            "type": "image_picker",
            "id": "email_icon",
            "label": "Email Icon",
            "info": "Upload custom icon for email (36x36px recommended). Leave empty to use default emoji."
        },
        {
            "type": "image_picker",
            "id": "address_icon",
            "label": "Address Icon",
            "info": "Upload custom icon for address (36x36px recommended). Leave empty to use default emoji."
        },
        {
            "type": "header",
            "content": "Spacing - Desktop"
        },
        {
            "type": "range",
            "id": "mg_top_desktop",
            "label": "Top Padding (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_bottom_desktop",
            "label": "Bottom Padding (Desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "header",
            "content": "Spacing - Tablet"
        },
        {
            "type": "range",
            "id": "mg_top_tablet",
            "label": "Top Padding (Tablet)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_bottom_tablet",
            "label": "Bottom Padding (Tablet)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "header",
            "content": "Spacing - Mobile"
        },
        {
            "type": "range",
            "id": "mg_top_mobile",
            "label": "Top Padding (Mobile)",
            "min": 0,
            "max": 100,
