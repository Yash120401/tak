{%- liquid
  assign container = section.settings.container
  assign section_title = section.settings.section_title
  assign section_description = section.settings.section_description
  assign layout_direction = section.settings.layout_direction
  assign content_alignment = section.settings.content_alignment

  assign title_color = section.settings.title_color
  assign title_font_size = section.settings.title_font_size
  assign title_font_size_mobile = section.settings.title_font_size_mobile
  assign title_font_weight = section.settings.title_font_weight
  assign title_margin_bottom = section.settings.title_margin_bottom

  assign desc_color = section.settings.desc_color
  assign desc_font_size = section.settings.desc_font_size
  assign desc_font_size_mobile = section.settings.desc_font_size_mobile
  assign desc_line_height = section.settings.desc_line_height
  assign desc_margin_bottom = section.settings.desc_margin_bottom

  assign feature_box_bg = section.settings.feature_box_bg
  assign feature_box_border = section.settings.feature_box_border
  assign feature_text_color = section.settings.feature_text_color
  assign feature_font_size = section.settings.feature_font_size
  assign feature_icon_color = section.settings.feature_icon_color

  assign primary_btn_bg = section.settings.primary_btn_bg
  assign primary_btn_text_color = section.settings.primary_btn_text_color
  assign primary_btn_border = section.settings.primary_btn_border
  assign primary_btn_bg_hover = section.settings.primary_btn_bg_hover
  assign primary_btn_text_hover_color = section.settings.primary_btn_text_hover_color

  assign secondary_btn_bg = section.settings.secondary_btn_bg
  assign secondary_btn_text_color = section.settings.secondary_btn_text_color
  assign secondary_btn_border = section.settings.secondary_btn_border
  assign secondary_btn_bg_hover = section.settings.secondary_btn_bg_hover
  assign secondary_btn_text_hover_color = section.settings.secondary_btn_text_hover_color

  assign gallery_bg_color = section.settings.gallery_bg_color
  assign image_caption_color = section.settings.image_caption_color
  assign nav_arrow_bg = section.settings.nav_arrow_bg
  assign nav_arrow_color = section.settings.nav_arrow_color

  assign section_bg_color = section.settings.section_bg_color
  assign section_bg_gradient = section.settings.section_bg_gradient

  assign mg_top_desktop = section.settings.mg_top_desktop
  assign mg_top_tablet = section.settings.mg_top_tablet
  assign mg_top_mobile = section.settings.mg_top_mobile
  assign mg_bottom_desktop = section.settings.mg_bottom_desktop
  assign mg_bottom_tablet = section.settings.mg_bottom_tablet
  assign mg_bottom_mobile = section.settings.mg_bottom_mobile

  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_left = section.settings.padding_left
  assign padding_right = section.settings.padding_right

  assign enable_animation = section.settings.enable_animation
  assign animation_type = section.settings.animation_type
-%}

<style>
  #factory-production-{{ section.id }} {
    margin-top: var(--mg-top-desktop);
    margin-bottom: var(--mg-bottom-desktop);
    {% if section_bg_gradient != blank %}
      background: {{ section_bg_gradient }};
    {% elsif section_bg_color != blank %}
      background-color: {{ section_bg_color }};
    {% endif %}
    padding: {{ padding_top }}px {{ padding_right }}px {{ padding_bottom }}px {{ padding_left }}px;
  }

  #factory-production-{{ section.id }} .section-title {
    color: {{ title_color }};
    font-size: {{ title_font_size }}px;
    font-weight: {{ title_font_weight }};
    margin-bottom: {{ title_margin_bottom }}px;
    line-height: 1.2;
  }

  #factory-production-{{ section.id }} .section-description {
    color: {{ desc_color }};
    font-size: {{ desc_font_size }}px;
    line-height: {{ desc_line_height }};
    margin-bottom: {{ desc_margin_bottom }}px;
  }

  #factory-production-{{ section.id }} .top-section {
    display: flex;
    align-items: flex-start;
    gap: 60px;
    margin-bottom: 60px;
  }

  #factory-production-{{ section.id }} .content-left {
    flex: 1;
  }

  #factory-production-{{ section.id }} .features-box {
    flex: 1;
    background-color: {{ feature_box_bg }};
    border: 2px solid {{ feature_box_border }};
    border-radius: 12px;
    padding: 32px;
  }

  #factory-production-{{ section.id }} .feature-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 16px;
    color: {{ feature_text_color }};
    font-size: {{ feature_font_size }}px;
    line-height: 1.5;
  }

  #factory-production-{{ section.id }} .feature-item:last-child {
    margin-bottom: 0;
  }

  #factory-production-{{ section.id }} .feature-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: {{ feature_icon_color }};
    margin-right: 12px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #factory-production-{{ section.id }} .feature-icon::after {
    content: '✓';
    color: white;
    font-size: 12px;
    font-weight: bold;
  }

  #factory-production-{{ section.id }} .buttons-wrapper {
    display: flex;
    gap: 16px;
    margin-top: 30px;
    flex-direction: column;
    width: 55%;
  }

  #factory-production-{{ section.id }} .btn-primary {
    background-color: {{ primary_btn_bg }};
    color: {{ primary_btn_text_color }};
    border: 2px solid {{ primary_btn_border }};
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #factory-production-{{ section.id }} .btn-primary:hover {
    background-color: {{ primary_btn_bg_hover }};
    color: {{ primary_btn_text_hover_color }};
    transform: translateY(-1px);
  }

  #factory-production-{{ section.id }} .btn-secondary {
    background-color: {{ secondary_btn_bg }};
    color: {{ secondary_btn_text_color }};
    border: 2px solid {{ secondary_btn_border }};
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #factory-production-{{ section.id }} .btn-secondary:hover {
    background-color: {{ secondary_btn_bg_hover }};
    color: {{ secondary_btn_text_hover_color }};
    transform: translateY(-1px);
  }

  #factory-production-{{ section.id }} .image-gallery-section {
    {% if gallery_bg_color != blank %}
      background-color: {{ gallery_bg_color }};
    {% endif %}
    padding: 40px;
    border-radius: 12px;
  }

  #factory-production-{{ section.id }} .gallery-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  #factory-production-{{ section.id }} .gallery-slide {
    display: none;
  }

  #factory-production-{{ section.id }} .gallery-slide.active {
    display: grid;
  }

  #factory-production-{{ section.id }} .image-item {
    text-align: center;
  }

  #factory-production-{{ section.id }} .image-wrapper {
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4/3;
    background: #f5f5f5;
    margin-bottom: 12px;
    border: 1px solid #e5e7eb;
  }

  #factory-production-{{ section.id }} .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #factory-production-{{ section.id }} .image-wrapper:hover img {
    transform: scale(1.05);
  }

  #factory-production-{{ section.id }} .image-caption {
    font-size: 14px;
    font-weight: 600;
    color: {{ image_caption_color }};
    margin: 0;
  }

  #factory-production-{{ section.id }} .gallery-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  #factory-production-{{ section.id }} .nav-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: {{ nav_arrow_bg }};
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: {{ nav_arrow_color }};
  }

  #factory-production-{{ section.id }} .nav-arrow:hover {
    background: {{ primary_btn_bg }};
    border-color: {{ primary_btn_bg }};
    color: white;
    transform: scale(1.1);
  }

  #factory-production-{{ section.id }} .nav-arrow.disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  #factory-production-{{ section.id }} .nav-arrow.disabled:hover {
    background: {{ nav_arrow_bg }};
    border-color: #e5e7eb;
    color: {{ nav_arrow_color }};
    transform: none;
  }

  #factory-production-{{ section.id }} .nav-arrow svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1199px) {
    #factory-production-{{ section.id }} {
      margin-top: var(--mg-top-tablet);
      margin-bottom: var(--mg-bottom-tablet);
    }

    #factory-production-{{ section.id }} .top-section {
      gap: 40px;
      margin-bottom: 50px;
    }

    #factory-production-{{ section.id }} .features-box {
      padding: 24px;
    }
  }

  @media (max-width: 767px) {
    #factory-production-{{ section.id }} {
      margin-top: var(--mg-top-mobile);
      margin-bottom: var(--mg-bottom-mobile);
      padding-top: 0px;
      padding-bottom: 0px;
    }
    #factory-production-{{ section.id }} .buttons-wrapper {
      width: 100%;
      flex-direction: row !important;
    }
    #factory-production-{{ section.id }} .section-title {
      font-size: {{ title_font_size_mobile }}px;
    }

    #factory-production-{{ section.id }} .section-description {
      font-size: {{ desc_font_size_mobile }}px;
    }

    #factory-production-{{ section.id }} .top-section {
      flex-direction: column;
      gap: 30px;
      margin-bottom: 0px;
      padding-bottom: 20px;
    }

    #factory-production-{{ section.id }} .buttons-wrapper {
      margin-top: 20px;
    }

    #factory-production-{{ section.id }} .btn-primary,
    #factory-production-{{ section.id }} .btn-secondary {
      padding: 8px 12px;
      font-size: 13px;
    }

    #factory-production-{{ section.id }} .gallery-container {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #factory-production-{{ section.id }} .image-gallery-section {
      padding: 20px;
    }

    #factory-production-{{ section.id }} .features-box {
      padding: 20px;
    }
  }
</style>

<div
  class="halo-block factory-production{% if enable_animation %} scroll-trigger animate--{{ animation_type }}{% endif %}"
  id="factory-production-{{ section.id }}"
  style="--mg-top-desktop: {{ mg_top_desktop }}px; --mg-top-tablet: {{ mg_top_tablet }}px; --mg-top-mobile: {{ mg_top_mobile }}px; --mg-bottom-desktop: {{ mg_bottom_desktop }}px; --mg-bottom-tablet: {{ mg_bottom_tablet }}px; --mg-bottom-mobile: {{ mg_bottom_mobile }}px;"
>
  <div class="{% if container == '1170' %}container-1170{% elsif container == '1470' %}container-1470{% elsif container == '1570' %}container-1570{% elsif container == '1770' %}container-1770{% elsif container == '1920' %}container-1920{% elsif container == 'fullwidth' %}container-full{% else %}container{% endif %}">
    <!-- Top Section: Title + Buttons and Features Box -->
    <div class="top-section{% if layout_direction == 'features-first' %} flex-row-reverse{% endif %}">
      <div class="content-left text-{{ content_alignment }}">
        {%- if section_title != blank -%}
          <h2
            class="section-title{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
            {% if enable_animation %}
              style="--animation-order: 1;"
            {% endif %}
          >
            {{ section_title }}
          </h2>
        {%- endif -%}

        {%- if section_description != blank -%}
          <p
            class="section-description{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
            {% if enable_animation %}
              style="--animation-order: 2;"
            {% endif %}
          >
            {{ section_description }}
          </p>
        {%- endif -%}

        <div
          class="buttons-wrapper{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
          {% if enable_animation %}
            style="--animation-order: 3;"
          {% endif %}
        >
          {%- if section.settings.primary_btn_text != blank -%}
            <a
              class="btn-primary active"
              href="#"
              data-content="facilities"
              onclick="switchContent(event, 'facilities')"
            >
              {{ section.settings.primary_btn_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="25" height="16" viewBox="0 0 25 16" fill="none">
                <path d="M24.7071 8.70711C25.0976 8.31658 25.0976 7.68342 24.7071 7.29289L18.3431 0.928932C17.9526 0.538408 17.3195 0.538408 16.9289 0.928932C16.5384 1.31946 16.5384 1.95262 16.9289 2.34315L22.5858 8L16.9289 13.6569C16.5384 14.0474 16.5384 14.6805 16.9289 15.0711C17.3195 15.4616 17.9526 15.4616 18.3431 15.0711L24.7071 8.70711ZM0 8V9H24V8V7H0V8Z" fill="#0E0F13"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_btn_text != blank -%}
            <a
              class="btn-secondary"
              href="#"
              data-content="customization"
              onclick="switchContent(event, 'customization')"
            >
              {{ section.settings.secondary_btn_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="25" height="16" viewBox="0 0 25 16" fill="none">
                <path d="M24.7071 8.70711C25.0976 8.31658 25.0976 7.68342 24.7071 7.29289L18.3431 0.928932C17.9526 0.538408 17.3195 0.538408 16.9289 0.928932C16.5384 1.31946 16.5384 1.95262 16.9289 2.34315L22.5858 8L16.9289 13.6569C16.5384 14.0474 16.5384 14.6805 16.9289 15.0711C17.3195 15.4616 17.9526 15.4616 18.3431 15.0711L24.7071 8.70711ZM0 8V9H24V8V7H0V8Z" fill="#0E0F13"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div
        class="features-box{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
        {% if enable_animation %}
          style="--animation-order: 4;"
        {% endif %}
      >
        <!-- Facilities Content -->
        <div class="content-section" id="facilities-content">
          {%- assign facilities_blocks = section.blocks | where: 'type', 'facilities_feature' -%}
          {%- if facilities_blocks.size > 0 -%}
            {%- for block in facilities_blocks -%}
              <div class="feature-item">
                <div class="feature-icon"></div>
                <span>{{ block.settings.feature_text }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Over 5,000 sqm of factory processing space</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>We also have 240,000 sqm of open space for drying products</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Advanced machinery for cleaning, sorting, and packaging</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Climate-controlled storage for maintaining product freshness</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Strict hygiene protocols</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Customization Content -->
        <div class="content-section" id="customization-content" style="display: none;">
          {%- assign customization_blocks = section.blocks | where: 'type', 'customization_feature' -%}
          {%- if customization_blocks.size > 0 -%}
            {%- for block in customization_blocks -%}
              <div class="feature-item">
                <div class="feature-icon"></div>
                <span>{{ block.settings.feature_text }}</span>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Custom packaging solutions tailored to your brand</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Flexible order quantities from small batches to large volumes</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Private labeling and co-packing services</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Specialized processing for unique product requirements</span>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <span>Rapid prototyping and product development support</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Bottom Section: Image Gallery -->
    <div
      class="image-gallery-section{% if enable_animation %} scroll-trigger animate--slide-in{% endif %}"
      {% if enable_animation %}
        style="--animation-order: 5;"
      {% endif %}
    >
      {%- assign image_blocks = section.blocks | where: 'type', 'image' -%}
      {%- assign total_slides = image_blocks.size | divided_by: 4.0 | ceil -%}

      {%- for i in (1..total_slides) -%}
        {%- assign start_index = forloop.index0 | times: 4 -%}
        {%- assign end_index = start_index | plus: 3 -%}

        <div class="gallery-slide{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}">
          <div class="gallery-container">
            {%- for j in (start_index..end_index) -%}
              {%- assign block = image_blocks[j] -%}
              {%- if block -%}
                <div class="image-item">
                  <div class="image-wrapper">
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', alt: block.settings.image_caption
                      }}
                    {%- else -%}
                      <div style="width: 100%; height: 100%; background: #f5f5f5; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px;">
                        No Image
                      </div>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.image_caption != blank -%}
                    <p class="image-caption">{{ block.settings.image_caption }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if total_slides > 1 -%}
        <div class="gallery-navigation">
          <div class="nav-arrow nav-prev" onclick="changeSlide(this, -1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </div>

          <div class="nav-arrow nav-next" onclick="changeSlide(this, 1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('factory-production-{{ section.id }}');
    if (!section) return;

    const slides = section.querySelectorAll('.gallery-slide');
    const prevArrow = section.querySelector('.nav-prev');
    const nextArrow = section.querySelector('.nav-next');
    let currentSlide = 0;

    function updateSlideVisibility() {
      slides.forEach((slide, index) => {
        slide.classList.toggle('active', index === currentSlide);
      });

      if (prevArrow && nextArrow) {
        prevArrow.classList.toggle('disabled', currentSlide === 0);
        nextArrow.classList.toggle('disabled', currentSlide === slides.length - 1);
      }
    }

    window.changeSlide = function(element, direction) {
      if (element.classList.contains('disabled')) return;

      const newSlide = currentSlide + direction;
      if (newSlide >= 0 && newSlide < slides.length) {
        currentSlide = newSlide;
        updateSlideVisibility();
      }
    };

    // Content switching function
    window.switchContent = function(event, contentType) {
      event.preventDefault();

      const section = document.getElementById('factory-production-{{ section.id }}');
      const primaryBtn = section.querySelector('.btn-primary');
      const secondaryBtn = section.querySelector('.btn-secondary');
      const facilitiesContent = section.querySelector('#facilities-content');
      const customizationContent = section.querySelector('#customization-content');

      // Remove active class from all buttons
      primaryBtn.classList.remove('active');
      secondaryBtn.classList.remove('active');

      // Show/hide content based on selection and add active class
      if (contentType === 'facilities') {
        primaryBtn.classList.add('active');
        facilitiesContent.style.display = 'block';
        customizationContent.style.display = 'none';
      } else if (contentType === 'customization') {
        secondaryBtn.classList.add('active');
        facilitiesContent.style.display = 'none';
        customizationContent.style.display = 'block';
      }
    };

    // Initialize
    updateSlideVisibility();

    // Auto-hide navigation if only one slide
    if (slides.length <= 1 && section.querySelector('.gallery-navigation')) {
      section.querySelector('.gallery-navigation').style.display = 'none';
    }
  });
</script>

{% schema %}
{
  "name": "Factory Production",
  "class": "section-factory-production",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Default Container"
        },
        {
          "value": "1170",
          "label": "1170px"
        },
        {
          "value": "1470",
          "label": "1470px"
        },
        {
          "value": "1570",
          "label": "1570px"
        },
        {
          "value": "1770",
          "label": "1770px"
        },
        {
          "value": "1920",
          "label": "1920px"
        },
        {
          "value": "fullwidth",
          "label": "Full Width"
        }
      ]
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout Direction",
      "default": "content-first",
      "options": [
        {
          "value": "content-first",
          "label": "Content First, Features Second"
        },
        {
          "value": "features-first",
          "label": "Features First, Content Second"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Our Factory Production"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "State-of-the-art facilities and advanced machinery ensure the highest quality standards in our production process."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
