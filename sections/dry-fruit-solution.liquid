{%- liquid
  assign container = section.settings.container
  assign section_heading = section.settings.section_heading
  assign section_description = section.settings.section_description

  assign section_bg_color = section.settings.section_bg_color
  assign section_bg_gradient = section.settings.section_bg_gradient
  assign card_bg_color = section.settings.card_bg_color
  assign content_bg_color = section.settings.content_bg_color

  assign heading_color = section.settings.heading_color
  assign heading_font_size_desktop = section.settings.heading_font_size_desktop
  assign heading_font_size_tablet = section.settings.heading_font_size_tablet
  assign heading_font_size_mobile = section.settings.heading_font_size_mobile
  assign heading_font_weight = section.settings.heading_font_weight

  assign desc_color = section.settings.desc_color
  assign desc_font_size_desktop = section.settings.desc_font_size_desktop
  assign desc_font_size_mobile = section.settings.desc_font_size_mobile

  assign card_title_color = section.settings.card_title_color
  assign card_subtitle_color = section.settings.card_subtitle_color
  assign card_text_color = section.settings.card_text_color

  assign card_padding_desktop = section.settings.card_padding_desktop
  assign card_padding_tablet = section.settings.card_padding_tablet
  assign card_padding_mobile = section.settings.card_padding_mobile

  assign image_margin_bottom = section.settings.image_margin_bottom
  assign image_border_radius = section.settings.image_border_radius
  assign card_border_radius = section.settings.card_border_radius

  assign mg_top_desktop = section.settings.mg_top_desktop
  assign mg_top_tablet = section.settings.mg_top_tablet
  assign mg_top_mobile = section.settings.mg_top_mobile
  assign mg_bottom_desktop = section.settings.mg_bottom_desktop
  assign mg_bottom_tablet = section.settings.mg_bottom_tablet
  assign mg_bottom_mobile = section.settings.mg_bottom_mobile

  assign padding_top_desktop = section.settings.padding_top_desktop
  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  assign padding_top_mobile = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile

  assign enable_animation = section.settings.enable_animation
  assign animation_type = section.settings.animation_type
-%}

<style>
  #dry-fruit-solutions-{{ section.id }} {
    margin-top: {{ mg_top_desktop }}px;
    margin-bottom: {{ mg_bottom_desktop }}px;
    padding-top: {{ padding_top_desktop }}px;
    padding-bottom: {{ padding_bottom_desktop }}px;
    {% if section_bg_gradient != blank %}
      background: {{ section_bg_gradient }};
    {% elsif section_bg_color != blank %}
      background-color: {{ section_bg_color }};
    {% else %}
      background-color: #f5f5f0;
    {% endif %}
  }

  #dry-fruit-solutions-{{ section.id }} .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  #dry-fruit-solutions-{{ section.id }} .section-heading {
    color: {{ heading_color }};
    font-size: {{ heading_font_size_desktop }}px;
    font-weight: {{ heading_font_weight }};
    margin-bottom: 20px;
    line-height: 1.2;
  }

  #dry-fruit-solutions-{{ section.id }} .section-description {
    color: {{ desc_color }};
    font-size: {{ desc_font_size_desktop }}px;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  #dry-fruit-solutions-{{ section.id }} .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: stretch;
    grid-auto-rows: 1fr;
  }

  #dry-fruit-solutions-{{ section.id }} .solution-card {
    background-color: {{ card_bg_color | default: 'transparent' }};
    border-radius: {{ card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #dry-fruit-solutions-{{ section.id }} .solution-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
  }

  #dry-fruit-solutions-{{ section.id }} .card-content {
    padding: {{ card_padding_desktop }}px;
    overflow: hidden;
    background: {{ content_bg_color | default: '#F1EDE8' }};
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #dry-fruit-solutions-{{ section.id }} .card-image {
    width: 100%;
    height: 250px;
    overflow: hidden;
    margin-bottom: {{ image_margin_bottom }}px;
    border-radius: {{ image_border_radius }}px;
    flex-shrink: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  #dry-fruit-solutions-{{ section.id }} .solution-card:hover .card-image img {
    transform: scale(1.05);
  }

  #dry-fruit-solutions-{{ section.id }} .card-title {
    color: {{ card_title_color }};
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 10px;
    flex-shrink: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-subtitle {
    color: {{ card_subtitle_color }};
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 15px;
    flex-shrink: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description {
    color: {{ card_text_color }};
    font-size: 16px;
    line-height: 1.6;
    flex: 1;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description p {
    margin-bottom: 15px;
    margin-top: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description p:first-child {
    margin-top: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description p:last-child,
  #dry-fruit-solutions-{{ section.id }} .card-description ul:last-child,
  #dry-fruit-solutions-{{ section.id }} .card-description ol:last-child {
    margin-bottom: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description ul,
  #dry-fruit-solutions-{{ section.id }} .card-description ol {
    margin: 10px 0 15px 0;
    padding-left: 20px;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description li {
    margin-bottom: 8px;
    list-style-position: outside;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description li:last-child {
    margin-bottom: 0;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description ul li {
    list-style-type: disc;
  }

  #dry-fruit-solutions-{{ section.id }} .card-description ol li {
    list-style-type: decimal;
  }

  /* Tablet Styles */
  @media (max-width: 1024px) {
    #dry-fruit-solutions-{{ section.id }} {
      margin-top: {{ mg_top_tablet }}px;
      margin-bottom: {{ mg_bottom_tablet }}px;
    }

    #dry-fruit-solutions-{{ section.id }} .section-heading {
      font-size: {{ heading_font_size_tablet }}px;
    }

    #dry-fruit-solutions-{{ section.id }} .cards-grid {
      gap: 30px;
      grid-auto-rows: 1fr;
    }

    #dry-fruit-solutions-{{ section.id }} .card-content {
      padding: {{ card_padding_tablet }}px;
      height: 100%;
    }
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    #dry-fruit-solutions-{{ section.id }} {
      margin-top: {{ mg_top_mobile }}px;
      margin-bottom: {{ mg_bottom_mobile }}px;
      padding-top: {{ padding_top_mobile }}px;
      padding-bottom: {{ padding_bottom_mobile }}px;
    }

    #dry-fruit-solutions-{{ section.id }} .section-header {
      margin-bottom: 40px;
    }

    #dry-fruit-solutions-{{ section.id }} .section-heading {
      font-size: {{ heading_font_size_mobile }}px;
    }

    #dry-fruit-solutions-{{ section.id }} .section-description {
      font-size: {{ desc_font_size_mobile }}px;
    }

    #dry-fruit-solutions-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      grid-auto-rows: auto;
    }

    #dry-fruit-solutions-{{ section.id }} .card-image {
      height: 200px;
    }

    #dry-fruit-solutions-{{ section.id }} .card-content {
      padding: {{ card_padding_mobile }}px;
      height: 100%;
    }

    #dry-fruit-solutions-{{ section.id }} .card-title {
      font-size: 20px;
    }

    #dry-fruit-solutions-{{ section.id }} .card-subtitle {
      font-size: 16px;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description {
      font-size: 14px;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description p {
      margin-bottom: 12px;
      margin-top: 0;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description ul,
    #dry-fruit-solutions-{{ section.id }} .card-description ol {
      padding-left: 15px;
      margin: 8px 0 12px 0;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description li {
      margin-bottom: 6px;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description li:last-child {
      margin-bottom: 0;
    }

    #dry-fruit-solutions-{{ section.id }} .card-description p:last-child,
    #dry-fruit-solutions-{{ section.id }} .card-description ul:last-child,
    #dry-fruit-solutions-{{ section.id }} .card-description ol:last-child {
      margin-bottom: 0;
    }
  }

  /* Animation Styles */
  {% if enable_animation %}
    #dry-fruit-solutions-{{ section.id }} .animate--{{ animation_type }} {
      opacity: 0;
      transform: translateY(20px);
    }

    #dry-fruit-solutions-{{ section.id }} .animate--{{ animation_type }}.animated {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    #dry-fruit-solutions-{{ section.id }} .solution-card {
      opacity: 0;
      transform: translateY(30px);
    }

    #dry-fruit-solutions-{{ section.id }} .solution-card.animated {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    #dry-fruit-solutions-{{ section.id }} .solution-card.animated:hover {
      transform: translateY(-5px);
    }

    #dry-fruit-solutions-{{ section.id }} .solution-card:nth-child(1) { transition-delay: 0.1s; }
    #dry-fruit-solutions-{{ section.id }} .solution-card:nth-child(2) { transition-delay: 0.2s; }
    #dry-fruit-solutions-{{ section.id }} .solution-card:nth-child(3) { transition-delay: 0.3s; }
    #dry-fruit-solutions-{{ section.id }} .solution-card:nth-child(4) { transition-delay: 0.4s; }
  {% endif %}
</style>

<div id="dry-fruit-solutions-{{ section.id }}" class="dry-fruit-solutions-section">
  <div class="{% if container == '1170' %}container-1170{% elsif container == '1470' %}container-1470{% elsif container == '1570' %}container-1570{% elsif container == '1770' %}container-1770{% elsif container == '1920' %}container-1920{% elsif container == 'fullwidth' %}container-full{% else %}container{% endif %}">
    <div class="section-header">
      {%- if section_heading != blank -%}
        <h2 class="section-heading{% if enable_animation %} scroll-trigger animate--{{ animation_type }}{% endif %}">
          {{ section_heading }}
        </h2>
      {%- endif -%}

      {%- if section_description != blank -%}
        <p class="section-description{% if enable_animation %} scroll-trigger animate--{{ animation_type }}{% endif %}">
          {{ section_description }}
        </p>
      {%- endif -%}
    </div>

    <div class="cards-grid">
      {%- for block in section.blocks -%}
        <div class="solution-card{% if enable_animation %} scroll-trigger{% endif %}" {{ block.shopify_attributes }}>
          <div class="card-content">
            <div class="card-image">
              {%- if block.settings.card_image != blank -%}
                {{
                  block.settings.card_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', sizes: '(max-width: 768px) 100vw, 50vw', widths: '375, 550, 750, 1100'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            {%- if block.settings.card_title != blank -%}
              <h3 class="card-title">{{ block.settings.card_title }}</h3>
            {%- endif -%}

            {%- if block.settings.card_subtitle != blank -%}
              <h4 class="card-subtitle">{{ block.settings.card_subtitle }}</h4>
            {%- endif -%}

            {%- if block.settings.card_description != blank -%}
              <div class="card-description">
                {{ block.settings.card_description }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if enable_animation -%}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animated');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('#dry-fruit-solutions-{{ section.id }} .scroll-trigger').forEach(el => {
        observer.observe(el);
      });
    });
  </script>
{%- endif -%}

