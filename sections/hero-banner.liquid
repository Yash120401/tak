      height: {{ section.settings.banner_height_mobile | default: 500 | times: 0.8 }}px;
    }

    .banner-heading {
      font-size: {{ section.settings.heading_size_mobile | default: 36 | times: 0.78 }}px;
      line-height: {{ section.settings.heading_line_height_mobile | default: 44 | times: 0.82 }}px;
    }

    .banner-description {
      font-size: {{ section.settings.description_size_mobile | default: 16 | times: 0.875 }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('banner-video-{{ section.id }}');

    if (video) {
      console.log('Banner video element found');

      let isReloading = false;
      let reloadTimeout;

      // Function to safely reload and play video
      function reloadVideo() {
        if (isReloading) {
          console.log('Video reload already in progress, skipping...');
          return;
        }

        isReloading = true;
        console.log('Reloading video...');

        // Clear any existing timeout
        if (reloadTimeout) {
          clearTimeout(reloadTimeout);
        }

        // Pause and reset video
        video.pause();
        video.currentTime = 0;

        // Remove and re-add sources to force complete reload
        const sources = video.querySelectorAll('source');
        const sourceUrls = Array.from(sources).map(source => ({
          src: source.src,
          type: source.type
        }));

        // Clear existing sources
        sources.forEach(source => source.remove());

        // Re-add sources after a brief delay
        setTimeout(function() {
          sourceUrls.forEach(sourceData => {
            const newSource = document.createElement('source');
            newSource.src = sourceData.src;
            newSource.type = sourceData.type;
            video.appendChild(newSource);
          });

          // Load and play
          video.load();

          reloadTimeout = setTimeout(function() {
            video.play().then(function() {
              console.log('Video playing successfully');
              isReloading = false;
            }).catch(function(error) {
              console.log('Video autoplay failed:', error);
              isReloading = false;
            });
          }, 200);
        }, 100);
      }

      // Initial load
      reloadVideo();

      // Handle page visibility changes (language switches)
      let visibilityHandler = function() {
        if (!document.hidden && video) {
          console.log('Page became visible, reloading video');
          setTimeout(reloadVideo, 300); // Small delay to ensure page is fully loaded
        }
      };

      // Handle window focus
      let focusHandler = function() {
        if (video && (video.paused || video.readyState === 0)) {
          console.log('Window focused, attempting to restart video');
          setTimeout(reloadVideo, 200);
        }
      };

      // Remove existing listeners first (in case script runs multiple times)
      document.removeEventListener('visibilitychange', visibilityHandler);
      window.removeEventListener('focus', focusHandler);

      // Add event listeners
      document.addEventListener('visibilitychange', visibilityHandler);
      window.addEventListener('focus', focusHandler);

      // Video event listeners
      video.addEventListener('loadeddata', function() {
        console.log('Video data loaded successfully');
      });

      video.addEventListener('error', function(e) {
        console.log('Video error details:', e);
        console.log('Video error code:', video.error ? video.error.code : 'Unknown');
        isReloading = false; // Reset flag on error
      });

      video.addEventListener('stalled', function() {
        console.log('Video stalled, attempting reload...');
        setTimeout(reloadVideo, 1000);
      });

      video.addEventListener('loadstart', function() {
        console.log('Video load started');
      });

      // Cleanup function for when section is removed
      window.addEventListener('beforeunload', function() {
        if (reloadTimeout) {
          clearTimeout(reloadTimeout);
        }
        document.removeEventListener('visibilitychange', visibilityHandler);
        window.removeEventListener('focus', focusHandler);
      });

    } else {
      console.log('Banner video element not found');
    }
  });
</script>

{% schema %}
