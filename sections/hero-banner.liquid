<!-- home-banner.liquid -->
{% comment %} Auto-translation logic based on URL {% endcomment %}
{% assign current_url = request.path %}
{% assign is_turkish = false %}
{% assign is_russian = false %}

{% if current_url contains '/tr' %}
  {% assign is_turkish = true %}
{% elsif current_url contains '/ru' %}
  {% assign is_russian = true %}
{% endif %}

{% comment %} Translation mappings {% endcomment %}
{% if is_turkish %}
  {% assign translated_heading_part_1 = 'Premium' %}
  {% assign translated_heading_highlight = 'Tarım' %}
  {% assign translated_heading_part_2 = 'Ürünleri' %}
  {% assign translated_description = "Afganistan'ın Kalbinden Dünya Standartlarında Kuru Meyve ve Tarım Ürünleri Sunuyoruz" %}
  {% assign translated_button_text = 'Alışveriş Yap' %}
{% elsif is_russian %}
  {% assign translated_heading_part_1 = 'Премиум' %}
  {% assign translated_heading_highlight = 'Сельское хозяйство' %}
  {% assign translated_heading_part_2 = 'Продукты' %}
  {% assign translated_description = 'Поставляем сухофрукты и сельскохозяйственную продукцию мирового класса из сердца Афганистана' %}
  {% assign translated_button_text = 'Купить сейчас' %}
{% else %}
  {% assign translated_heading_part_1 = section.settings.heading_part_1 %}
  {% assign translated_heading_highlight = section.settings.heading_highlight %}
  {% assign translated_heading_part_2 = section.settings.heading_part_2 %}
  {% assign translated_description = section.settings.description %}
  {% assign translated_button_text = section.settings.button_text %}
{% endif %}

<div class="home-banner-section">
  <div class="banner-container">
    <div class="banner-wrapper">
      <div class="banner-item">
        <!-- Video Background -->
        <div class="video-background">
          {% if section.settings.background_video != blank %}
            <video
              autoplay
              loop
              muted
              playsinline
              preload="auto"
              class="banner-video"
            >
              <source src="{{ section.settings.background_video }}" type="video/mp4">
              <source src="{{ section.settings.background_video }}" type="video/webm">
              Your browser does not support the video tag.
            </video>
          {% endif %}

          <!-- Fallback Image -->
          {% if section.settings.background_image != blank %}
            <img
              src="{{ section.settings.background_image | img_url: '1920x800' }}"
              alt="{{ translated_heading_part_1 | escape }} {{ translated_heading_highlight | escape }} {{ translated_heading_part_2 | escape }}"
              class="banner-image-fallback"
              loading="lazy"
            >
          {% endif %}
        </div>

        <!-- Content Overlay -->
        <div class="banner-content">
          <div class="content-container container-{{ section.settings.content_container }}{% if section.settings.content_container == 'fullwidth' %} container-full{% endif %}">
            <div class="content-wrapper">
              {% comment %} Fixed heading structure with proper conditions and div wrapping {% endcomment %}
              {% if translated_heading_part_1 != blank
                or translated_heading_highlight != blank
                or translated_heading_part_2 != blank
              %}
                <div class="banner-heading-wrapper">
                  <h1 class="banner-heading">
                    {% if translated_heading_part_1 != blank %}
                      <div class="heading-part-1">{{ translated_heading_part_1 }}</div>
                    {% endif %}
                    {% if translated_heading_highlight != blank %}
                      <div class="heading-highlight">
                        <span class="highlight-text">{{ translated_heading_highlight }}</span>
                      </div>
                    {% endif %}
                    {% if translated_heading_part_2 != blank %}
                      <div class="heading-part-2">{{ translated_heading_part_2 }}</div>
                    {% endif %}
                  </h1>
                </div>
              {% endif %}

              {% if translated_description != blank %}
                <div class="banner-description-wrapper">
                  <p class="banner-description">{{ translated_description }}</p>
                </div>
              {% endif %}

              {% if translated_button_text != blank and section.settings.button_url != blank %}
                <div class="banner-button-wrapper">
                  <a href="{{ section.settings.button_url }}" class="button banner-button">
                    <span>{{ translated_button_text }}</span>
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .home-banner-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: {{ section.settings.section_padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.section_padding_bottom | default: 0 }}px;
  }

  /* Banner Container - Always Full Width */
  .banner-container {
    position: relative;
    width: 100%;
  }

  /* Content Container System */
  .content-container {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .content-container.container-1170 {
    max-width: 1170px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .content-container.container-1370 {
    max-width: 1370px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .content-container.container-1470 {
    max-width: 1470px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .content-container.container-1570 {
    max-width: 1570px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .content-container.container-1770 {
    max-width: 1770px;
    padding-left: 15px;
    padding-right: 15px;
  }

  .content-container.container-fullwidth,
  .content-container.container-full {
    max-width: 100%;
    padding-left: {{ section.settings.content_padding_full_width | default: 25 }}px;
    padding-right: {{ section.settings.content_padding_full_width | default: 25 }}px;
  }

  .banner-wrapper {
    position: relative;
    width: 100%;
  }

  .banner-item {
    position: relative;
    width: 100%;
    height: {{ section.settings.banner_height_desktop | default: 800 }}px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  /* Video Background Styles */
  .video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .banner-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .banner-image-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0; /* Lower z-index than video, shows when video fails */
  }

  /* Hide fallback image when video is playing */
  .banner-video:not([style*="display: none"]) ~ .banner-image-fallback {
    display: none;
  }

  /* Content Overlay */
  .banner-content {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: {{ section.settings.content_padding_top | default: 0 }}px 0 {{ section.settings.content_padding_bottom | default: 0 }}px 0;
  }

  .content-wrapper {
    width: 100%;
    text-align: {{ section.settings.content_alignment | default: 'left' }};
    margin-top: {{ section.settings.content_margin_top | default: 0 }}px;
    margin-bottom: {{ section.settings.content_margin_bottom | default: 0 }}px;
    padding-left: {{ section.settings.content_inner_padding_horizontal | default: 0 }}px;
    padding-right: {{ section.settings.content_inner_padding_horizontal | default: 0 }}px;
  }

  /* Heading Structure Styles */
  .banner-heading-wrapper {
    margin-bottom: 20px;
  }

  .banner-heading {
    font-size: {{ section.settings.heading_size_desktop | default: 64 }}px;
    line-height: {{ section.settings.heading_line_height_desktop | default: 72 }}px;
    font-weight: {{ section.settings.heading_weight | default: 700 }};
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    margin: 0;
    width: 700px;
    letter-spacing: var(--heading-letter-spacing, 0);
  }

  .heading-part-1,
  .heading-part-2,
  .heading-highlight {
    display: inline-block;
    margin-right: 0.25em;
  }

  .heading-part-1 {
    /* Custom styles for first part if needed */
  }

  .heading-highlight {
    /* Custom styles for highlight wrapper if needed */
  }

  .heading-part-2 {
    /* Custom styles for second part if needed */
  }

  .highlight-text {
    color: {{ section.settings.highlight_color | default: '#4CAF50' }};
  }

  /* Description Styles */
  .banner-description-wrapper {
    margin-bottom: 50px;
  }

  .banner-description {
    font-size: {{ section.settings.description_size_desktop | default: 20 }}px;
    line-height: {{ section.settings.description_line_height_desktop | default: 26 }}px;
    color: {{ section.settings.description_color | default: '#ffffff' }};
    margin: 0;
    max-width: 600px;
  }

  /* Button Styles */
  .banner-button-wrapper {
    /* Wrapper for additional button styling if needed */
  }

  .banner-button {
    display: inline-block;
    padding: 15px 30px;
    background-color: {{ section.settings.button_bg | default: '#232323' }};
    color: {{ section.settings.button_text_color | default: '#ffffff' }};
    text-decoration: none;
    border: 2px solid {{ section.settings.button_border | default: '#232323' }};
    font-weight: 500;
    transition: all 0.3s ease;
    min-width: 200px;
    text-align: center;
  }

  .banner-button:hover {
    background-color: {{ section.settings.button_bg_hover | default: '#ffffff' }};
    color: {{ section.settings.button_text_color_hover | default: '#232323' }};
    border-color: {{ section.settings.button_border_hover | default: '#232323' }};
  }

  /* Tablet Styles */
  @media screen and (max-width: 1024px) {
    .home-banner-section {
      padding-top: {{ section.settings.section_padding_top | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
      padding-bottom: {{ section.settings.section_padding_bottom | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
    }

    .banner-item {
      height: {{ section.settings.banner_height_tablet | default: 600 }}px;
    }

    .banner-content {
      padding: {{ section.settings.content_padding_top | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px 0 {{ section.settings.content_padding_bottom | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px 0;
    }

    .content-wrapper {
      padding-left: {{ section.settings.content_inner_padding_horizontal | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
      padding-right: {{ section.settings.content_inner_padding_horizontal | default: 0 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
    }

    .banner-heading {
      font-size: {{ section.settings.heading_size_tablet | default: 34 }}px;
      line-height: {{ section.settings.heading_line_height_tablet | default: 42 }}px;
    }

    .banner-description {
      font-size: {{ section.settings.description_size_tablet | default: 18 }}px;
    }

    .banner-description-wrapper {
      margin-bottom: {{ section.settings.description_margin_bottom | default: 50 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
    }

    .content-container.container-fullwidth,
    .content-container.container-full {
      padding-left: {{ section.settings.content_padding_full_width | default: 25 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
      padding-right: {{ section.settings.content_padding_full_width | default: 25 | times: section.settings.tablet_padding_multiplier | default: 0.8 }}px;
    }
  }

  /* Mobile Styles */
  @media screen and (max-width: 768px) {
    .home-banner-section {
      padding-top: {{ section.settings.section_padding_top | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
      padding-bottom: {{ section.settings.section_padding_bottom | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
    }

    .banner-item {
      height: {{ section.settings.banner_height_mobile | default: 500 }}px;
      align-items: center;
      justify-content: center;
    }

    .banner-content {
      padding: {{ section.settings.content_padding_top | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px 0 {{ section.settings.content_padding_bottom | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px 0;
      text-align: center;
    }

    .content-wrapper {
      margin-top: {{ section.settings.content_margin_top | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
      margin-bottom: {{ section.settings.content_margin_bottom | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
      padding-left: {{ section.settings.content_inner_padding_horizontal | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
      padding-right: {{ section.settings.content_inner_padding_horizontal | default: 0 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
    }

    .banner-heading {
      font-size: {{ section.settings.heading_size_mobile | default: 36 }}px;
      line-height: {{ section.settings.heading_line_height_mobile | default: 44 }}px;
      color: {{ section.settings.heading_color_mobile | default: '#ffffff' }};
    }

    .banner-description {
      font-size: {{ section.settings.description_size_mobile | default: 16 }}px;
      color: {{ section.settings.description_color_mobile | default: '#ffffff' }};
    }

    .banner-description-wrapper {
      margin-bottom: {{ section.settings.description_margin_bottom | default: 50 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
    }

    .banner-button {
      padding: 12px 25px;
      min-width: 180px;
    }

    .content-container.container-fullwidth,
    .content-container.container-full {
      padding-left: {{ section.settings.content_padding_full_width | default: 25 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
      padding-right: {{ section.settings.content_padding_full_width | default: 25 | times: section.settings.mobile_padding_multiplier | default: 0.5 }}px;
    }
  }

  @media screen and (max-width: 480px) {
