            "pdf_metafield_namespace": "custom",
            "pdf_metafield_key": "afghanistan_pdf_url"
          }
        },
        {
          "type": "region_tab",
          "settings": {
            "region_name": "Uzbekistan",
            "table_metafield_namespace": "Region2_Table",
            "table_metafield_key": "region2_table",
            "image_metafield_namespace": "custom",
            "image_metafield_key": "uzbekistan_images",
            "pdf_metafield_namespace": "custom",
            "pdf_metafield_key": "uzbekistan_pdf_url"
          }
        },
        {
          "type": "region_tab",
          "settings": {
            "region_name": "Tajikistan",
